{
  "name": "@verstaan/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The console as a web app: a Fastify server with a JSON API and a change stream, and a React client. Not on the translation path.",
  "license": "MPL-2.0",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "dev": "concurrently -n server,client -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server && npm run typecheck",
    "start": "node dist-server/server/src/index.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.59.0",
    "fastify": "^5.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
