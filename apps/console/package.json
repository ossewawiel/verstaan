{
  "name": "@verstaan/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The console as a web app: a Fastify server with a JSON API and a change stream, and a React client. Not on the translation path.",
  "license": "MPL-2.0",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "dev": "concurrently -n server,client -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server/src/index.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/static": "^7.0.4",
    "@tanstack/react-query": "^5.59.0",
    "fastify": "^4.28.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
