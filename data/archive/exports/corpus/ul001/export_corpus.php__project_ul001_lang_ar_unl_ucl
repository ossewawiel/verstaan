83:77.@past.@posterior,     202203362:58.@present)<br />aoj(301148283:77.@past.@posterior,     600000565:81.@1.@emphasis)<br />mod(301148283:77.@past.@posterior,     400047534:23)<br />{/unl}<br />[/S]<br /><br />[S:375459]<br />{org:fr}<br />Mon ami le renard, me dit-il (pds).<br />{/org}<br />{ar}<br />أمير صغير يقول صديقي أنا عن الثعلب<br />{/ar}<br />{ar}<br />أمير صغير يقول صديقي عن الثعلب أنا <br />{/ar}<br />{ar}<br />يقول أمير صغير صديقي أنا عن الثعلب<br />{/ar}<br />{ar}<br />يقول أمير صغير صديقي عن الثعلب أنا<br />{/ar}<br />{unl}<br />agt(201009240:93.@present.@entry,     500324405:57)<br />gol(201009240:93.@present.@entry,     600000565:35.@1)<br />pos(110112591:18,     600000565:35.@1)<br />obj(201009240:93.@present.@entry,     110112591:18)<br />cnt(110112591:18,     102118333:76.@def)<br />{/unl}<br />[/S]<br /><br />[S:375460]<br />{org:fr}<br />Mon petit bonhomme, il ne s’agit plus du renard!<br />{/org}<br />{ar}<br />لا يكون مسألة أكثر الثعلب ورفيقي صغير<br />{/ar}<br />{ar}<br />لا يكون شأن أكثر الثعلب ورفيقي صغير<br />{/ar}<br />{ar}<br />لا يكون أمر أكثر الثعلب ورفيقي صغير<br />{/ar}<br />{unl}<br />pos(109945905:68,     600000565:50.@1)<br />mod(109945905:68,     301391351:35)<br />aoj(105671325:47.@present.@not.@entry.@more,     600000565:56.@ellipsis)<br />obj(105671325:47.@present.@not.@entry.@more,     102118333:16.@def)<br />and(109945905:68,     105671325:47.@present.@not.@entry.@more)<br />{/unl}<br />[/S]<br /><br />[S:375461]<br />{org:fr}<br />Parce qu’on va mourir de soif (pds).<br />{/org}<br />{ar}<br />بسبب عطش سوف يموت<br />{/ar}<br />{ar}<br />سوف يموت بسبب عطش<br />{/ar}<br />{unl}<br />aoj(200358431:94.@future.@recent.@entry,     600000565:57)<br />rsn(600000565:91,     200358431:94.@future.@recent.@entry)<br />rsn(200358431:94.@future.@recent.@entry,     114040660:97)<br />{/unl}<br />[/S]<br /><br />[S:375462]<br />{org:fr}<br />Il ne comprit pas mon raisonnement, il me répondit:<br />{/org}<br />{ar}<br />أمير صغير لم يفهم جدالي وأجابني<br />{/ar}<br />{ar}<br />أمير صغير لم يفهم جدالي وجاوبني<br />{/ar}<br />{ar}<br />لم يفهم أمير صغير جدالي وأجابني<br />{/ar}<br />{ar}<br />لم يفهم أمير صغير جدالي وجاوبني<br />{/ar}<br />{ar}<br />لم يفهم أمير صغير نقاشي وجاوبني<br />{/ar}<br />{unl}<br />aoj(200588888:44.@past.@not,     500324405:99)<br />pos(105773049:54,     600000565:49.@1)<br />obj(200588888:44.@past.@not,     105773049:54)<br />agt(200815686:98.@past.@entry,     500324405:99)<br />gol(200815686:98.@past.@entry,     600000565:49.@1)<br />and(200815686:98.@past.@entry,     200588888:44.@past.@not)<br />{/unl}<br />[/S]<br /><br />[S:375463]<br />{org:fr}<br />C’est bien d’avoir eu un ami, même si l’on va mourir.<br />{/org}<br />{ar}<br />يكون جيد كان ملك صديق إذا لئن سيموت<br />{/ar}<br />{ar}<br />يكون جيد كان ملك صديق لئن سيموت<br />{/ar}<br />{ar}<br />إذا لئن سيموت يكون جيد كان ملك صديق<br />{/ar}<br />{ar}<br />لئن سيموت يكون جيد كان ملك صديق<br />{/ar}<br />{unl}<br />aoj(301123148:58.@present.@entry,     600000565:36)<br />obj(301123148:58.@present.@entry,     202378453:73.@past.@perfective)<br />obj(202378453:73.@past.@perfective,     110112591:44.@indef)<br />con(202378453:73.@past.@perfective,     202109818:43.@future.@recent.@even.@if)<br />obj(202109818:43.@future.@recent.@even.@if,     600000565:68)<br />{/unl}<br />[/S]<br /><br />[S:375464]<br />{org:fr}<br />Moi, je suis bien content d’avoir eu un ami renard (pds).<br />{/org}<br />{ar}<br />أنا نفسي أكون سعيد لإن لدي ثعلب صديق <br />{/ar}<br />{ar}<br />أنا نفسي أكون سعيد بيسبب لدي ثعلب صديق <br />{/ar}<br />{ar}<br />أنا نفسي أكون سعيد بيسبب ملكت ثعلب صديق <br />{/ar}<br />{ar}<br />أنا نفسي أكون سعيد لإن ملكت ثعلب صديق <br />{/ar}<br />{unl}<br />aoj(301148283:56.@emphasis.@present.@entry,     600000565:94.@1.@emphasis)<br />rsn(301148283:56.@emphasis.@present.@entry,     202203362:95.@past)<br />aoj(202203362:95.@past,     600000565:94.@1.@emphasis)<br />obj(202203362:95.@past,     102118333:15.@indef)<br />mod(102118333:15.@indef,     110112591:96)<br />{/unl}<br />[/S]<br /><br />[S:375465]<br />{org:fr}<br />Le petit prince, qui me posait beaucoup de questions, ne semblait jamais entendre les miennes.<br />{/org}<br />{ar}<br />أمير صغير الذي كان يشبه فهم تسأولاتي ابدا أمير صغير كان جعلي تساؤلات كثيرة      <br />{/ar}<br />{ar}<br />أمير صغير الذي كان يشبه فهم تسأولاتي ابدا أمير صغير كان جعلي تساؤلات عديدة<br />{/ar}<br />{ar}<br />أمير صغير الذي كان يشبه فهم تسأولاتي ابدا أمير صغير كان فعلي تساؤلات عديدة<br />{/ar}<br />{ar}<br />أمير صغير الذي كان يشبه فهم تسأولاتي مطلقا أمير صغير كان جعلي تساؤلات عديدة<br />{/ar}<br />{ar}<br />أمير صغير الذي كان يشبه فهم تسأولاتي مطلقا أمير صغير كان فعلي تساؤلات عديدة<br />{/ar}<br />{unl}<br />aoj(202665617:86.@past.@imperfective.@entry,     500324405:85)<br />man(202665617:86.@past.@imperfective.@entry,     400020759:93)<br />obj(202665617:86.@past.@imperfective.@entry,     200588888:35)<br />obj(200588888:35,     107193596:87.@pl)<br />pos(107193596:87.@pl,     600000565:41.@1)<br />agt(202560585:45.@past.@imperfective.@relative,     500324405:85)<br />obj(202560585:45.@past.@imperfective.@relative,     107193596:98.@pl.@multal)<br />gol(202560585:45.@past.@imperfective.@relative,     600000565:41.@1)<br />{/unl}<br />[/S]<br /><br />[S:375466]<br />{org:fr}<br />Il ne mesure pas le danger, me dis-je.<br />{/org}<br />{ar}<br />أنا أقول لنفسي أن أمير صغير لا يقدر خطر<br />{/ar}<br />{ar}<br />أقول لنفسي أن أمير صغير لا يقدر خطر<br />{/ar}<br />{unl}<br />aoj(200681429:52.@not.@speech.@present,     500324405:25)<br />obj(200681429:52.@not.@speech.@present,     114540765:15.@generic)<br />obj(201009240:35.@reflexive.@past.@entry,     200681429:52.@not.@speech.@present)<br />agt(201009240:35.@reflexive.@past.@entry,     600000565:54.@1)<br />{/unl}<br />[/S]<br /><br />[S:375467]<br />{org:fr}<br />Il n’a jamais ni faim ni soif.<br />{/org}<br />{ar}<br />أمير صغير لا لدى جوع أو عطش<br />{/ar}<br />{ar}<br />ليس لدى أمير صغير جوع أو عطش<br />{/ar}<br />{unl}<br />aoj(202108026:17.@experience.@not.@entry,     500324405:16)<br />obj(202108026:17.@experience.@not.@entry,     114040660:79)<br />obj(202108026:17.@experience.@not.@entry,     114039534:20)<br />or(114040660:79,     114039534:20)<br />{/unl}<br />[/S]<br /><br />[S:375468]<br />{org:fr}<br />Un peu de soleil lui suffit (pds).<br />{/org}<br />{ar}<br />بتردد بعض شمس كفت لأمير صغير<br />{/ar}<br />{ar}<br />بتردد كفت بعض شمس لأمير صغير<br />{/ar}<br />{unl}<br />aoj(202669789:59.@hesitation.@entry,     109450163:33.@paucal)<br />gol(202669789:59.@hesitation.@entry,     500324405:22)<br />{/unl}<br />[/S]<br /><br />[S:375469]<br />{org:fr}<br />Mais il me regarda et répondit à ma pensée:<br />{/org}<br />{ar}<br />أمير صغير شاهدني ولكن أجاب تفكيري  <br />{/ar}<br />{ar}<br />شاهدني أمير صغير ولكن أجاب تفكيري<br />{/ar}<br />{unl}<br />agt(202150510:61.@past,     500324405:76)<br />obj(202150510:61.@past,     600000565:77.@1)<br />agt(200815686:98.@past.@entry.@but,     500324405:76)<br />and(200815686:98.@past.@entry.@but,     202150510:61.@past)<br />pos(105770926:85,     600000565:77.@1)<br />and(200815686:98.@past.@entry.@but,     600000565:37)<br />{/unl}<br />[/S]<br /><br />[S:375470]<br />{org:fr}<br />J’ai soif aussi (pds).<br />{/org}<br />{ar}<br />أنا لدي عطش<br />{/ar}<br />{ar}<br />لدي عطش<br />{/ar}<br />{unl}<br />aoj(202203362:24.@present.@entry,     600000565:71.@1)<br />man(202203362:24.@present.@entry,     400047534:14)<br />obj(202203362:24.@present.@entry,     114040660:10)<br />{/unl}<br />[/S]<br /><br />[S:375471]<br />{org:fr}<br />cherchons un puits (pds).<br />{/org}<br />{ar}<br />بحث عن بئر<br />{/ar}<br />{unl}<br />obj(201315613:56.@imperative.@present.@entry,     104572344:29.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375472]<br />{org:fr}<br />J’eus un geste de lassitude:<br />{/org}<br />{ar}<br />أنا فعلت إيماءة إرهاق<br />{/ar}<br />{ar}<br />فعلت إيماءة إرهاق<br />{/ar}<br />{unl}<br />agt(200120316:84.@past.@entry,     600000565:69.@1)<br />obj(200120316:84.@past.@entry,     106876309:50.@indef)<br />mod(106876309:50.@indef,     114016361:94)<br />{/unl}<br />[/S]<br /><br />[S:375473]<br />{org:fr}<br />il est absurde de chercher un puits, au hasard, dans l’immensité du désert.<br />{/org}<br />{ar}<br />سخيف بحث بئر في الاتساع صحراء عشوائيا<br />{/ar}<br />{ar}<br />بحث سخيف بئر في الاتساع صحراء عشوائيا<br />{/ar}<br />{unl}<br />obj(201315613:89,     104572344:82.@indef)<br />man(201315613:89,     400070765:39)<br />plc(201315613:89,     105104548:16.@def)<br />mod(105104548:16.@def,     108505573:40)<br />aoj(301431112:62.@topic.@entry,     201315613:89)<br />{/unl}<br />[/S]<br /><br />[S:375474]<br />{org:fr}<br />Cependant nous nous mîmes en marche.<br />{/org}<br />{ar}<br />نحن وبالرغم من ذلك بدأنا مشينا<br />{/ar}<br />{ar}<br />بدأنا مشينا وبالرغم من ذلك<br />{/ar}<br />{unl}<br />agt(201904930:91.@inceptive.@past.@reflexive.@entry,     600000565:48.@1.@pl)<br />man(201904930:91.@inceptive.@past.@reflexive.@entry,     400027384:93)<br />{/unl}<br />[/S]<br /><br />[S:375475]<br />{org:fr}<br />Quand nous eûmes marché, des heures, en silence, la nuit tomba, et les étoiles commencèrent de s’éclairer.<br />{/org}<br />{ar}<br />النجوم هبطت الليل وسطعت في أنت كنت مشيت بصمت أثناء ساعات <br />{/ar}<br />{ar}<br />هبطت النجوم الليل وسطعت في أنت كنت مشيت بصمت أثناء ساعات<br />{/ar}<br />{ar}<br />هبطت النجوم الليل وسطعت في أنت كنت مشيت صمت أثناء ساعات<br />{/ar}<br />{ar}<br />النجوم هبطت الليل وسطعت في أنت كنت مشيت صمت أثناء ساعات <br />{/ar}<br />{ar}<br />هبطت النجوم الليل ولمعت في أنت كنت مشيت صمت أثناء ساعات<br />{/ar}<br />{unl}<br />dur(201904930:86.@past.@anterior.@perfective,     115227846:59.@indef.@pl)<br />agt(201904930:86.@past.@anterior.@perfective,     600000565:96.@pl.@2)<br />man(201904930:86.@past.@anterior.@perfective,     104982207:60)<br />obj(200342164:35.@past,     115167027:61.@def)<br />tim(200342164:35.@past,     201904930:86.@past.@anterior.@perfective)<br />aoj(202763740:76.@inceptive.@past.@entry,     109444100:48.@pl.@def)<br />and(202763740:76.@inceptive.@past.@entry,     200342164:35.@past)<br />tim(202763740:76.@inceptive.@past.@entry,     201904930:86.@past.@anterior.@perfective)<br />{/unl}<br />[/S]<br /><br />[S:375476]<br />{org:fr}<br />Ce sont des mots prononcés par hasard qui, peu à peu, m’ont tout révélé.<br />{/org}<br />{ar}<br />كلمات التي نطق كشفت لي كل شيء تدريجيا<br />{/ar}<br />{ar}<br />كلمات التي نطق كشفت كل شيء لي تدريجيا<br />{/ar}<br />{unl}<br />obj(200978549:81.@relative,     106286395:79.@pl.@indef.@topic)<br />man(200978549:81.@relative,     400040547:60)<br />aoj(200933821:84.@past.@entry,     106286395:79.@pl.@indef.@topic)<br />obj(200933821:84.@past.@entry,     600000565:16.@every.@thing)<br />man(200933821:84.@past.@entry,     400422281:12)<br />gol(200933821:84.@past.@entry,     600000565:57.@1)<br />{/unl}<br />[/S]<br /><br />[S:375477]<br />{org:fr}<br />Je les apercevais comme en rêve, ayant un peu de fièvre, à cause de ma soif.<br />{/org}<br />{ar}<br />أنا رأيت نجوم بحلم لإن لدي بعض حمى لإن عطشي <br />{/ar}<br />{ar}<br />أنا رأيت نجوم بحلم بسبب أن لدي بعض حمى بسبب عطشي<br />{/ar}<br />{ar}<br />أنا رأيت نجوم بمنام بسبب أن لدي بعض حمى بسبب عطشي<br />{/ar}<br />{ar}<br />أنا رأيت نجوم بمنام لإن لدي بعض حمى لإن عطشي<br />{/ar}<br />{ar}<br />أنا رأيت نجوم بحلم بسبب أن لدي قليل من حمى بسبب عطشي<br />{/ar}<br />{unl}<br />agt(202129289:31.@past.@imperfective.@entry,     600000565:76.@1)<br />obj(202129289:31.@past.@imperfective.@entry,     109444100:97.@pl)<br />man(202129289:31.@past.@imperfective.@entry,     105768553:14.@indef)<br />aoj(202203362:89,     600000565:76.@1)<br />obj(202203362:89,     114365356:11.@paucal)<br />rsn(202129289:31.@past.@imperfective.@entry,     202203362:89)<br />pos(114040660:71,     600000565:76.@1)<br />rsn(202203362:89,     114040660:71)<br />{/unl}<br />[/S]<br /><br />[S:375478]<br />{org:fr}<br />Les mots du petit prince dansaient dans ma mémoire:<br />{/org}<br />{ar}<br />كلمات أمير صغير تراقصت في ذاكرتي<br />{/ar}<br />{ar}<br />تراقصت كلمات أمير صغير في ذاكرتي<br />{/ar}<br />{unl}<br />agt(202099075:98.@past.@imperfective.@entry,     106286395:31.@pl)<br />mod(106286395:31.@pl,     500324405:83)<br />pos(105760202:40,     600000565:68.@1)<br />scn(202099075:98.@past.@imperfective.@entry,     105760202:40)<br />{/unl}<br />[/S]<br /><br />[S:375479]<br />{org:fr}<br />Tu as donc soif, toi aussi?<br />{/org}<br />{ar}<br />لذلك أنت أيضا لديك عطش؟<br />{/ar}<br />{ar}<br />لذلك لديك ظمأ أيضا؟<br />{/ar}<br />{ar}<br />لذلك أنت أيضا عطش؟<br />{/ar}<br />{unl}<br />aoj(202203362:58.@present.@so.@entry.@interrogative,     600000565:93.@2.@emphasis.@also)<br />obj(202203362:58.@present.@so.@entry.@interrogative,     114040660:98)<br />{/unl}<br />[/S]<br /><br />[S:375480]<br />{org:fr}<br />lui demandai-je.<br />{/org}<br />{ar}<br />أنا سألت أمير صغير<br />{/ar}<br />{ar}<br />سألت أمير صغير<br />{/ar}<br />{unl}<br />agt(200784727:50.@past.@entry,     600000565:47.@1)<br />gol(200784727:50.@past.@entry,     500324405:56)<br />{/unl}<br />[/S]<br /><br />[S:375481]<br />{org:fr}<br />Mais il ne répondit pas à ma question.<br />{/org}<br />{ar}<br />ولكن أمير صغير لم يجيب سؤالي<br />{/ar}<br />{ar}<br />ولكن أمير صغير لم أجاب سؤالي<br />{/ar}<br />{unl}<br />agt(200815686:46.@past.@not.@entry.@but,     500324405:48)<br />pos(107193596:14,     600000565:22.@1)<br />obj(200815686:46.@past.@not.@entry.@but,     107193596:14)<br />and(200815686:46.@past.@not.@entry.@but,     600000565:84)<br />{/unl}<br />[/S]<br /><br />[S:375482]<br />{org:fr}<br />Il me dit simplement:<br />{/org}<br />{ar}<br />أمير صغير يقول فقط لي<br />{/ar}<br />{ar}<br />أمير صغير يقول لي فقط<br />{/ar}<br />{ar}<br />أمير صغير أخبرني فقط<br />{/ar}<br />{unl}<br />agt(201009240:91.@present.@entry,     500324405:22)<br />gol(201009240:91.@present.@entry,     600000565:14.@1)<br />obj(201009240:91.@present.@entry,     600000565:81.@ellipsis)<br />man(201009240:91.@present.@entry,     400004722:51)<br />{/unl}<br />[/S]<br /><br />[S:375483]<br />{org:fr}<br />L’eau peut aussi être bonne pour le cœur (pds).<br />{/org}<br />{ar}<br />ماء يمكن أن يكون جيد القلب<br />{/ar}<br />{unl}<br />aoj(301123148:49.@possibility.@entry,     114845743:18.@generic)<br />man(301123148:49.@possibility.@entry,     400047534:65)<br />mod(301123148:49.@possibility.@entry,     105388805:33.@def)<br />{/unl}<br />[/S]<br /><br />[S:375484]<br />{org:fr}<br />Je ne compris pas sa réponse mais je me tus (pds).<br />{/org}<br />{ar}<br />أنا لم أفهم إجابة أمير صغير ولكن أنا سكت<br />{/ar}<br />{ar}<br />لم أفهم إجابة أمير صغير ولكن سكت<br />{/ar}<br />{ar}<br />لم أفهم إجابة أمير صغير ولكن صمت<br />{/ar}<br />{unl}<br />aoj(200591115:93.@past.@not,     600000565:33.@1)<br />pos(106746005:61,     500324405:66)<br />obj(200591115:93.@past.@not,     106746005:61)<br />and(201041061:21.@past.@but.@entry.@hesitation,     200591115:93.@past.@not)<br />agt(201041061:21.@past.@but.@entry.@hesitation,     600000565:33.@1)<br />{/unl}<br />[/S]<br /><br />[S:375485]<br />{org:fr}<br />Je savais bien qu’il ne fallait pas l’interroger.<br />{/org}<br />{ar}<br />أنا عرفت جيدا لا يجب سأل أمير صغير<br />{/ar}<br />{ar}<br />أنا عرفت جيدا يجب ألا سأل أمير صغير<br />{/ar}<br />{unl}<br />aoj(200594621:41.@past.@imperfective.@entry,     600000565:86.@1)<br />mod(200594621:41.@past.@imperfective.@entry,     400011093:12)<br />obj(200594621:41.@past.@imperfective.@entry,     200784727:79.@obligation.@not)<br />obj(200784727:79.@obligation.@not,     500324405:54)<br />{/unl}<br />[/S]<br /><br />[S:375486]<br />{org:fr}<br />Il était fatigué.<br />{/org}<br />{ar}<br />أمير صغير كان متعب<br />{/ar}<br />{ar}<br />أمير صغير كان مرهق<br />{/ar}<br />{unl}<br />aoj(302431728:39.@past.@imperfective.@entry,     500324405:76)<br />{/unl}<br />[/S]<br /><br />[S:375487]<br />{org:fr}<br />Ainsi, quand il aperçut pour la première fois mon avion (je ne dessinerai pas mon avion, c’est un dessin beaucoup trop compliqué pour moi) il me demanda:<br />{/org}<br />{ar}<br />لذا سأل الأمير الصغير في رأى طائرتي لأول مرة لن أتتبع طائرتي لأن طائرتي رسمة معقدة إلى حد كبير <br />{/ar}<br />{ar}<br />لذا سأل الأمير الصغير في رأى طائرتي لأول مرة لن أتتبع طائرتي لأنها رسمة معقدة  جدا<br />{/ar}<br />{ar}<br />لذا سأل الأمير الصغير في رأى طائرتي في البداية لن أتتبع طائرتي لأن طائرتي رسمة معقدة إلى حد كبير<br />{/ar}<br />{ar}<br />لذا سألني الأمير الصغير عندما رأى طائرتي لأول مرة لن أتتبع طائرتي لأن طائرتي رسمة معقدة إلى حد كبير<br />{/ar}<br />{ar}<br />لذا سألني الأمير الصغير في رأى طائرتي في البداية لن أتتبع طائرتي لأن طائرتي رسمة معقدة إلى حد كبير<br />{/ar}<br />{unl}<br />agt(202129289:88.@past,     500324405:16.@def)<br />man(202129289:88.@past,     400103554:18)<br />pos(102691156:86,     600000565:33.@1)<br />obj(202129289:88.@past,     102691156:86)<br />agt(201582645:38.@future.@not,     600000565:56.@1)<br />obj(201582645:38.@future.@not,     102691156:86)<br />aoj(302177584:75,     103234306:30.@indef.@topic)<br />mod(302177584:75,     400089408:65)<br />agt(200784342:48.@past.@so.@entry,     500324405:16.@def)<br />gol(200784342:48.@past.@so.@entry,     600000565:56.@1)<br />tim(200784342:48.@past.@so.@entry,     202129289:88.@past)<br />rsn(102691156:86,     103234306:30.@indef.@topic)<br />{/unl}<br />[/S]<br /><br />[S:375488]<br />{org:fr}<br />Il s’assit.<br />{/org}<br />{ar}<br />أمير صغير جلس<br />{/ar}<br />{ar}<br />جلس أمير صغير<br />{/ar}<br />{unl}<br />agt(201984902:17.@past.@entry,     500324405:37)<br />{/unl}<br />[/S]<br /><br />[S:375489]<br />{org:fr}<br />Je m’assis auprès de lui.<br />{/org}<br />{ar}<br />أنا جلست بالقرب من أمير صغير<br />{/ar}<br />{ar}<br />جلست أنا بالقرب من أمير صغير<br />{/ar}<br />{ar}<br />جلست بالقرب من أمير صغير<br />{/ar}<br />{unl}<br />agt(201543123:77.@past.@close_to.@entry,     600000565:88.@1)<br />plc(201543123:77.@past.@close_to.@entry,     500324405:24)<br />{/unl}<br />[/S]<br /><br />[S:375490]<br />{org:fr}<br />Et, après un silence, il dit encore:<br />{/org}<br />{ar}<br />ويقول أمير صغير بعد سكون <br />{/ar}<br />{ar}<br />ويقول أمير صغير بعد وجوم<br />{/ar}<br />{unl}<br />agt(201009240:47.@present.@entry,     500324405:82)<br />and(201009240:47.@present.@entry,     600000565:91.@ellipsis)<br />tim(201009240:47.@present.@entry,     113925550:49.@indef.@after)<br />man(201009240:47.@present.@entry,     400040365:31)<br />{/unl}<br />[/S]<br /><br />[S:375491]<br />{org:fr}<br />Les étoiles sont belles, à cause d’une fleur que l’on ne voit pas (pds).<br />{/org}<br />{ar}<br />نحن الذي لا رأى زهرة نجوم جميلة بسبب زهرة<br />{/ar}<br />{ar}<br />نجوم جميلة بسبب لا نرى زهرة <br />{/ar}<br />{ar}<br />نجوم جميلة لأن لا رأينا زهرة جميلة<br />{/ar}<br />{unl}<br />aoj(300217728:23.@entry,     109444100:78.@pl)<br />agt(202129289:51.@not.@relative,     600000565:46.@1.@pl)<br />obj(202129289:51.@not.@relative,     111669921:69.@indef)<br />rsn(300217728:23.@entry,     111669921:69.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375492]<br />{org:fr}<br />Je répondis  bien sûr  et je regardai, sans parler, les plis du sable sous la lune.<br />{/org}<br />{ar}<br />أنا نظرت إلى حروف الرمل تحت ضوء القمروجاوبت بالطبع لم تكلم<br />{/ar}<br />{ar}<br />نظرت إلى حروف الرمل تحت ضوء القمر وجاوبت بالطبع لم تفوه<br />{/ar}<br />{unl}<br />agt(200815686:31.@past,     600000565:37.@1)<br />mod(200815686:31.@past,     400038625:34)<br />and(202130524:29.@past.@entry,     200815686:31.@past)<br />agt(202130524:29.@past.@entry,     600000565:37.@1)<br />man(200815686:31.@past,     200941990:83.@not)<br />mod(109409512:24.@def.@pl,     115019030:56.@def)<br />scn(109409512:24.@def.@pl,     111484975:60.@def.@under)<br />obj(202130524:29.@past.@entry,     109409512:24.@def.@pl)<br />{/unl}<br />[/S]<br /><br />[S:375493]<br />{org:fr}<br />Le désert est beau , ajouta-t-il (pds).<br />{/org}<br />{ar}<br />  الصحراء جميلة أمير صغير أضاف<br />{/ar}<br />{ar}<br />أضاف أمير صغير الصحراء جميلة<br />{/ar}<br />{unl}<br />agt(200182406:25.@past.@entry,     500324405:85)<br />aoj(300217728:39,     108505573:79.@def)<br />obj(200182406:25.@past.@entry,     300217728:39)<br />{/unl}<br />[/S]<br /><br />[S:375494]<br />{org:fr}<br />Et c’était vrai.<br />{/org}<br />{ar}<br />وكان صحيح<br />{/ar}<br />{ar}<br />وكان حقيقي<br />{/ar}<br />{unl}<br />aoj(302460502:72.@past.@imperfective.@entry,     600000565:45)<br />and(302460502:72.@past.@imperfective.@entry,     600000565:55)<br />{/unl}<br />[/S]<br /><br />[S:375495]<br />{org:fr}<br />J’ai toujours aimé le désert.<br />{/org}<br />{ar}<br />أنا أحب صحراء دائما<br />{/ar}<br />{ar}<br />أحب صحراء دائما<br />{/ar}<br />{unl}<br />aoj(201775164:91.@past.@entry,     600000565:89.@1)<br />obj(201775164:91.@past.@entry,     108505573:83.@generic)<br />tim(201775164:91.@past.@entry,     400019339:34)<br />{/unl}<br />[/S]<br /><br />[S:375496]<br />{org:fr}<br />On s’assoit sur une dune de sable.<br />{/org}<br />{ar}<br />أنا أجلس على كثب رملي<br />{/ar}<br />{ar}<br />أجلس أنا على كثب رملي<br />{/ar}<br />{ar}<br />أجلس على كثب رملي<br />{/ar}<br />{unl}<br />agt(201984902:23.@present.@entry,     600000565:99.@1.@pl)<br />mod(109270735:76.@on,     115019030:88)<br />plc(201984902:23.@present.@entry,     109270735:76.@on)<br />{/unl}<br />[/S]<br /><br />[S:375497]<br />{org:fr}<br />On ne voit rien.<br />{/org}<br />{ar}<br />نحن نرى لا شيء<br />{/ar}<br />{ar}<br />نرى لا شيء<br />{/ar}<br />{unl}<br />agt(202129289:50.@present.@entry,     600000565:81.@1.@pl)<br />obj(202129289:50.@present.@entry,     600000565:97.@not.@thing)<br />{/unl}<br />[/S]<br /><br />[S:375498]<br />{org:fr}<br />Qu’est ce que c’est que cette chose-là?<br />{/org}<br />{ar}<br />ما ذلك شيء؟<br />{/ar}<br />{ar}<br />ما تلك شيء؟<br />{/ar}<br />{unl}<br />aoj(600000565:64.@wh.@topic.@interrogative.@entry,     600000565:28.@thing.@distal)<br />{/unl}<br />[/S]<br /><br />[S:375499]<br />{org:fr}<br />On n’entend rien.<br />{/org}<br />{ar}<br />نحن نسمع لا شيء<br />{/ar}<br />{ar}<br />نسمع لا شيء<br />{/ar}<br />{unl}<br />aoj(202169702:18.@present.@entry,     600000565:87.@1.@pl)<br />obj(202169702:18.@present.@entry,     600000565:63.@not.@thing)<br />{/unl}<br />[/S]<br /><br />[S:375500]<br />{org:fr}<br />Et cependant quelque chose rayonne en silence (pds).<br />{/org}<br />{ar}<br />شيء ما يومض بهدوء بالرغم من ذلك<br />{/ar}<br />{ar}<br />على أية حال شيء ما يومض بهدوء<br />{/ar}<br />{unl}<br />man(202160779:64.@hesitation.@present.@entry,     104982207:30)<br />aoj(202160779:64.@hesitation.@present.@entry,     600000565:43.@some.@thing)<br />man(202160779:64.@hesitation.@present.@entry,     400027384:81)<br />{/unl}<br />[/S]<br /><br />[S:375501]<br />{org:fr}<br />Ce qui embellit le désert, dit le petit prince, c’est qu’il cache un puits quelque part (pds).<br />{/org}<br />{ar}<br />قال أمير صغير يزين الصحراء ان يخفي بئر في مكان ما<br />{/ar}<br />{unl}<br />aoj(202144835:31.@present,     201675963:11.@present.@speech.@topic.@hesitation)<br />obj(201009240:88.@past.@entry,     201675963:11.@present.@speech.@topic.@hesitation)<br />obj(201675963:11.@present.@speech.@topic.@hesitation,     108505573:81.@def)<br />agt(201009240:88.@past.@entry,     500324405:80)<br />aoj(202144835:31.@present,     108505573:81.@def)<br />obj(202144835:31.@present,     104572344:78.@indef)<br />plc(202144835:31.@present,     400025559:39)<br />{/unl}<br />[/S]<br /><br />[S:375502]<br />{org:fr}<br />Je fus surpris de comprendre soudain ce mystérieux rayonnement du sable.<br />{/org}<br />{ar}<br />تفاجأت فهم فجأة هذا ضوء رمل خفي<br />{/ar}<br />{ar}<br />أنا تفاجأت فهم فجأة هذا ضوء رمل خفي<br />{/ar}<br />{unl}<br />obj(200725274:87.@past.@passive.@entry,     600000565:54.@1)<br />man(200591115:48,     400061677:28)<br />obj(200591115:48,     111473954:62.@proximal)<br />mod(111473954:62.@proximal,     300900071:51)<br />mod(111473954:62.@proximal,     115019030:12)<br />agt(200725274:87.@past.@passive.@entry,     200591115:48)<br />{/unl}<br />[/S]<br /><br />[S:375503]<br />{org:fr}<br />Lorsque j’étais petit garçon j’habitais une maison ancienne, et la légende racontait qu’un trésor y était enfoui.<br />{/org}<br />{ar}<br />وقالت الأسطور دفن كنز في منزل قديم أنا كنت أسكنه في صبي<br />{/ar}<br />{ar}<br />وقالت الأسطورة دفن كنز في منزل قديم كنت أسكن فيه عندما صبي<br />{/ar}<br />{unl}<br />aoj(110285313:40.@past.@imperfective,     600000565:73.@1)<br />tim(202649830:75.@past.@imperfective,     110285313:40.@past.@imperfective)<br />aoj(202649830:75.@past.@imperfective,     600000565:73.@1)<br />plc(202649830:75.@past.@imperfective,     103259505:41.@indef)<br />mod(103259505:41.@indef,     301638438:65)<br />aoj(200953216:50.@past.@imperfective.@entry,     106371413:32.@def)<br />and(200953216:50.@past.@imperfective.@entry,     202649830:75.@past.@imperfective)<br />obj(201234625:89.@passive.@past.@imperfective,     113370448:86.@indef)<br />obj(200953216:50.@past.@imperfective.@entry,     201234625:89.@passive.@past.@imperfective)<br />plc(201234625:89.@passive.@past.@imperfective,     103259505:41.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375504]<br />{org:fr}<br />Bien sûr, jamais personne n’a su le découvrir, ni peut-être même ne l’a cherché.<br />{/org}<br />{ar}<br />لايمكن أن شخص لم يبحث عن الكنز أبدا ولم يكتشف بالطبع<br />{/ar}<br />{unl}<br />agt(202154508:29.@past.@not.@ability.@entry,     600000565:39.@person)<br />man(202154508:29.@past.@not.@ability.@entry,     400038625:83)<br />obj(202154508:29.@past.@not.@ability.@entry,     113370669:26.@def)<br />agt(600000565:39.@person,     201315613:92.@past.@not)<br />obj(201315613:92.@past.@not,     113370669:26.@def)<br />tim(201315613:92.@past.@not,     400146387:34)<br />and(201315613:92.@past.@not,     202154508:29.@past.@not.@ability.@entry)<br />{/unl}<br />[/S]<br /><br />[S:375505]<br />{org:fr}<br />Mais il enchantait toute cette maison.<br />{/org}<br />{ar}<br />ولكن أمير صغير فتن هذا منزل كامل  <br />{/ar}<br />{ar}<br />ولكن امير صغير فتن هذا منزل تام<br />{/ar}<br />{unl}<br />agt(201817314:28.@past.@imperfective.@entry.@but,     500324405:75)<br />obj(201817314:28.@past.@imperfective.@entry.@but,     103544360:62.@proximal)<br />mod(103544360:62.@proximal,     300514884:67)<br />and(201817314:28.@past.@imperfective.@entry.@but,     600000565:63)<br />{/unl}<br />[/S]<br /><br />[S:375506]<br />{org:fr}<br />Ma maison cachait un secret au fond de son cœur (pds).<br />{/org}<br />{ar}<br /> منزلي كان يخفى سر في أسفل وسطه<br />{/ar}<br />{ar}<br />سكني كان يخفي سر في أسفل مركزه<br />{/ar}<br />{unl}<br />pos(103544360:66,     600000565:81.@1)<br />aoj(202144835:64.@past.@imperfective.@hesitation.@entry,     103544360:66)<br />obj(202144835:64.@past.@imperfective.@hesitation.@entry,     106673142:10.@indef)<br />pos(108523483:70,     103544360:66)<br />mod(108511970:53.@def,     108523483:70)<br />scn(202144835:64.@past.@imperfective.@hesitation.@entry,     108511970:53.@def)<br />{/unl}<br />[/S]<br /><br />[S:375507]<br />{org:fr}<br />Oui, dis-je au petit prince, qu’il s’agisse de la maison, des étoiles ou du désert, ce qui fait leur beauté est invisible!<br />{/org}<br />{ar}<br />نعم أنا قلت لأمير صغيربغض النظر لشكل جمال في صحراء أو نجم أو منزل<br />{/ar}<br />{ar}<br />نعم قلت لأمير صغير شكل جمال صحراء أو نجم أو سكن بغض النظر <br />{/ar}<br />{unl}<br />obj(201009240:41.@past.@entry,     107203900:20.@speech)<br />agt(201009240:41.@past.@entry,     600000565:31.@1)<br />gol(201009240:41.@past.@entry,     500324405:80)<br />aoj(202620587:92.@speech,     600000565:35)<br />obj(202620587:92.@speech,     104683814:17)<br />aoj(302517265:88,     600000565:35)<br />or(108505573:56.@generic,     109444100:23.@generic)<br />or(109444100:23.@generic,     103544360:25.@generic)<br />mod(104683814:17,     103544360:25.@generic)<br />mod(104683814:17,     109444100:23.@generic)<br />mod(104683814:17,     108505573:56.@generic)<br />man(103544360:25.@generic,     400118531:57)<br />man(109444100:23.@generic,     400118531:57)<br />man(108505573:56.@generic,     400118531:57)<br />obj(201009240:41.@past.@entry,     202620587:92.@speech)<br />{/unl}<br />[/S]<br /><br />[S:375508]<br />{org:fr}<br />Je suis content, dit-il, que tu sois d’accord avec mon renard.<br />{/org}<br />{ar}<br />أمير صغير قال أنا مسرور عن أنت تراضيت ثعلبي  <br />{/ar}<br />{ar}<br />قال أمير صغير أنا مسرور أنت تراضيت ثعلبي<br />{/ar}<br />{unl}<br />aoj(301361414:45.@present.@speech,     600000565:49.@1)<br />aoj(200805376:62.@present.@subjective,     600000565:56.@2)<br />cnt(301361414:45.@present.@speech,     200805376:62.@present.@subjective)<br />obj(201009240:78.@past.@entry,     301361414:45.@present.@speech)<br />agt(201009240:78.@past.@entry,     500324405:31)<br />gol(200805376:62.@present.@subjective,     102118333:16)<br />pos(102118333:16,     600000565:84.@1)<br />{/unl}<br />[/S]<br /><br />[S:375509]<br />{org:fr}<br />Mais peu d’entre elles s’en souviennent.<br />{/org}<br />{ar}<br />لكن بعض بالغين ذكروا <br />{/ar}<br />{ar}<br />لكن قليل من بالغين ذكروا <br />{/ar}<br />{unl}<br />aoj(200607780.@contrast.@entry,     109605289.@paucal)<br />{/unl}<br />[/S]<br /><br />[S:375510]<br />{org:fr}<br />Ce n’est pas une chose.<br />{/org}<br />{ar}<br />هذا ليس شيء <br />{/ar}<br />{ar}<br />هذا لا يكون شيء<br />{/ar}<br />{ar}<br />هذه ليست شيء<br />{/ar}<br />{ar}<br />هذه لا تكون شيء<br />{/ar}<br />{unl}<br />aoj(104424218:84.@indef.@not.@present.@entry,     600000565:42.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375511]<br />{org:fr}<br />Comme le petit prince s’endormait, je le pris dans mes bras, et me remis en route.<br />{/org}<br />{ar}<br />أنا استوليت على أمير صغير في أذرعي لنام وبدأت مشى<br />{/ar}<br />{ar}<br />استوليت على أمير صغير في أذرعي لنام وبدأت مشى<br />{/ar}<br />{unl}<br />agt(201216670:26.@past.@entry,     600000565:14.@1)<br />obj(201216670:26.@past.@entry,     500324405:84)<br />pos(105563770:48.@pl,     600000565:14.@1)<br />plc(201216670:26.@past.@entry,     105563770:48.@pl)<br />obj(200345761:88.@past,     201904930:85)<br />agt(200345761:88.@past,     600000565:14.@1)<br />and(200345761:88.@past,     201216670:26.@past.@entry)<br />rsn(201216670:26.@past.@entry,     200014742:15.@past.@imperfective)<br />aoj(200014742:15.@past.@imperfective,     500324405:84)<br />{/unl}<br />[/S]<br /><br />[S:375512]<br />{org:fr}<br />J’étais ému.<br />{/org}<br />{ar}<br />أنا كنت متأثر<br />{/ar}<br />{ar}<br />كنت متأثر<br />{/ar}<br />{unl}<br />aoj(301559903:88.@past.@imperfective.@entry,     600000565:45.@1)<br />{/unl}<br />[/S]<br /><br />[S:375513]<br />{org:fr}<br />Il me semblait porter un trésor fragile.<br />{/org}<br />{ar}<br />أمير صغير بدا لي احتوى كنز هش<br />{/ar}<br />{ar}<br />بدا أمير صغير لي احتوى كنز سريع الكسر<br />{/ar}<br />{unl}<br />aoj(202133435:55.@past.@imperfective.@entry,     500324405:26)<br />gol(202133435:55.@past.@imperfective.@entry,     600000565:56.@1)<br />obj(202133435:55.@past.@imperfective.@entry,     202700867:11)<br />obj(202700867:11,     113370448:47.@indef)<br />mod(113370448:47.@indef,     300709215:33)<br />{/unl}<br />[/S]<br /><br />[S:375514]<br />{org:fr}<br />Il me semblait même qu’il n’y eût rien de plus fragile sur la Terre.<br />{/org}<br />{ar}<br />أنا بديت لاشيء هش في<br />{/ar}<br />{ar}<br />بديت لا شيء هش في<br />{/ar}<br />{unl}<br />gol(202134672:91.@past.@imperfective.@even.@entry,     600000565:84.@1)<br />aoj(300709215:25.@more.@past,     600000565:27.@not.@thing)<br />obj(202134672:91.@past.@imperfective.@even.@entry,     300709215:25.@more.@past)<br />plc(300709215:25.@more.@past,     109270894:61)<br />{/unl}<br />[/S]<br /><br />[S:375515]<br />{org:fr}<br />Je regardais, à la lumière de la lune, ce front pâle, ces yeux clos, ces mèches de cheveux qui tremblaient au vent, et je me disais:<br />{/org}<br />{ar}<br />أنا الذي قلت ونظرت إلى تلك ضفائر شعر التي ارتعشت في الريح وهذه العيون و هذه جبهة فاتحة في ضوء القمر<br />{/ar}<br />{ar}<br /> 	 أنا الذي قلت ونظرت إلى تلك جدائل شعر التي ارتجفت في الريح وهذه العيون و هذه جبهة شاحبة في ضوء القمر<br />{/ar}<br />{unl}<br />aoj(202130524:48.@past.@imperfective,     600000565:77.@1)<br />scn(202130524:48.@past.@imperfective,     111484975:67.@def)<br />obj(202130524:48.@past.@imperfective,     105602548:40.@proximal)<br />mod(105602548:40.@proximal,     300408992:68)<br />mod(105311054:52.@pl.@proximal,     301655162:18)<br />obj(202130524:48.@past.@imperfective,     105311054:52.@pl.@proximal)<br />and(105311054:52.@pl.@proximal,     105602548:40.@proximal)<br />mod(105257737:45.@pl.@distal,     105254795:59)<br />obj(202130524:48.@past.@imperfective,     105257737:45.@pl.@distal)<br />and(105257737:45.@pl.@distal,     105311054:52.@pl.@proximal)<br />aoj(201888511:70.@relative.@past.@imperfective,     105257737:45.@pl.@distal)<br />scn(201888511:70.@relative.@past.@imperfective,     111525955:72.@def)<br />agt(201009240:60.@reflexive.@past.@imperfective.@entry,     600000565:77.@1)<br />and(201009240:60.@reflexive.@past.@imperfective.@entry,     202130524:48.@past.@imperfective)<br />{/unl}<br />[/S]<br /><br />[S:375516]<br />{org:fr}<br />Ce que je vois là n’est qu’une écorce.<br />{/org}<br />{ar}<br />أنا الذي أرى لحاء في ذلك<br />{/ar}<br />{ar}<br />أنا الذي أرى في ذلك قشرة <br />{/ar}<br />{unl}<br />aoj(202129289:71.@present.@relative.@topic.@entry,     600000565:67.@1)<br />scn(202129289:71.@present.@relative.@topic.@entry,     600000565:52.@distal)<br />obj(202129289:71.@present.@relative.@topic.@entry,     113162297:45.@only.@present.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375517]<br />{org:fr}<br />Le plus important est invisible (pds).<br />{/org}<br />{ar}<br />أهم غير مرئي<br />{/ar}<br />{ar}<br />أهم لا مرئي<br />{/ar}<br />{ar}<br />أهم خفي<br />{/ar}<br />{unl}<br />aoj(302517265:52.@entry,     301275562:87.@most)<br />{/unl}<br />[/S]<br /><br />[S:375518]<br />{org:fr}<br />Comme ses lèvres entr’ouvertes ébauchaient un demi-sourire je me dis encore:<br />{/org}<br />{ar}<br />أنا قلت لنفسي ثانية لأن شفاه أمير صغير مفتوحة بين ابتسامة جزئي<br />{/ar}<br />{ar}<br />قلت لنفسي ثانية بسبب شفاه أمير صغير مفتوحة عبر ابتسامة جزئي<br />{/ar}<br />{unl}<br />agt(201009240:59.@past.@reflexive.@entry.@again,     600000565:80.@1)<br />pos(105305806:32.@pl,     500324405:41)<br />mod(105305806:32.@pl,     301654377:58)<br />aoj(200943837:18.@past.@imperfective,     105305806:32.@pl)<br />rsn(201009240:59.@past.@reflexive.@entry.@again,     200943837:18.@past.@imperfective)<br />obj(201009240:59.@past.@reflexive.@entry.@again,     600000565:33.@ellipsis)<br />obj(200943837:18.@past.@imperfective,     106878071:14.@indef)<br />mod(106878071:14.@indef,     300524496:28)<br />{/unl}<br />[/S]<br /><br />[S:375519]<br />{org:fr}<br />Ce qui m’émeut si fort de ce petit prince endormi, c’est sa fidélité pour une fleur, c’est l’image d’une rose qui rayonne en lui comme la flamme d’une lampe, même quand il dort (pds).<br />{/org}<br />{ar}<br />التصور الذي لمع لوردة في أمير صغير مثل إشعال مصباح حتى نام هذا أمير صغير والتزامه لزهرة تؤثر في أنا بعمق<br />{/ar}<br />{ar}<br />الصورة ذهنية التي لمع في  هذا أمير صغير لوردة مثل إشعال مصباح حتى نام هذا أمير صغير والتزامه لزهرة تؤثر في بعمق لذلك <br />{/ar}<br />{unl}<br />obj(201767949:38.@present.@topic.@entry.@hesitation,     600000565:76.@1)<br />man(201767949:38.@present.@topic.@entry.@hesitation,     400173353:60.@so)<br />cnt(201767949:38.@present.@topic.@entry.@hesitation,     500324405:98.@proximal)<br />pos(101206153:19.@topic,     500324405:98.@proximal)<br />ben(101206153:19.@topic,     111669921:30.@indef)<br />and(105928118:67.@topic.@def,     101206153:19.@topic)<br />aoj(201767949:38.@present.@topic.@entry.@hesitation,     101206153:19.@topic)<br />aoj(201767949:38.@present.@topic.@entry.@hesitation,     105928118:67.@topic.@def)<br />mod(105928118:67.@topic.@def,     112620196:53.@indef)<br />aoj(202763740:61.@relative,     105928118:67.@topic.@def)<br />scn(202763740:61.@relative,     500324405:98.@proximal)<br />man(202763740:61.@relative,     113480848:34.@def.@like)<br />mod(113480848:34.@def.@like,     103636248:83.@indef)<br />tim(202763740:61.@relative,     200014742:28.@even)<br />aoj(200014742:28.@even,     500324405:98.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375520]<br />{org:fr}<br />Et je le devinai plus fragile encore.<br />{/org}<br />{ar}<br />أنا تفهمت أمير صغير حتى كان رقيق<br />{/ar}<br />{ar}<br />تفهمت أمير صغير حتى كان رقيق<br />{/ar}<br />{unl}<br />aoj(200591519:40.@past.@entry,     600000565:59.@1)<br />aoj(300706688:20.@past.@imperfective.@more.@even,     500324405:33)<br />obj(200591519:40.@past.@entry,     300706688:20.@past.@imperfective.@more.@even)<br />and(200591519:40.@past.@entry,     600000565:94)<br />{/unl}<br />[/S]<br /><br />[S:375521]<br />{org:fr}<br />Ça vole.<br />{/org}<br />{ar}<br />هذا يطير<br />{/ar}<br />{ar}<br />هذه تطير<br />{/ar}<br />{unl}<br />agt(201940403:79.@present.@entry,     600000565:41.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375522]<br />{org:fr}<br />Il faut bien protéger les lampes:<br />{/org}<br />{ar}<br />يجب يحمي المصابيح جيدا<br />{/ar}<br />{ar}<br />لابد يحمي المصابيح بشكل جيد <br />{/ar}<br />{unl}<br />man(201128193:92.@present.@obligation.@entry,     400011093:82)<br />obj(201128193:92.@present.@obligation.@entry,     103636248:21.@def.@pl)<br />{/unl}<br />[/S]<br /><br />[S:375523]<br />{org:fr}<br />un coup de vent peut les éteindre (pds).<br />{/org}<br />{ar}<br />عاصفة يمكن أن أطفأ مصباح<br />{/ar}<br />{ar}<br />يمكن أطفأ عصفة مصباح<br />{/ar}<br />{unl}<br />agt(202761897:70.@possibility.@hesitation.@entry,     111465017:71.@indef)<br />obj(202761897:70.@possibility.@hesitation.@entry,     103636248:41)<br />{/unl}<br />[/S]<br /><br />[S:375524]<br />{org:fr}<br />Et, marchant ainsi, je découvris le puits au lever du jour.<br />{/org}<br />{ar}<br />أنا وجدت البئر مشى في فجر <br />{/ar}<br />{ar}<br />وجدت بئر مشى في فجر<br />{/ar}<br />{unl}<br />agt(202154508:54.@past.@entry,     600000565:10.@1)<br />man(202154508:54.@past.@entry,     201904930:71)<br />and(202154508:54.@past.@entry,     600000565:41.@ellipsis)<br />obj(202154508:54.@past.@entry,     104572344:99.@def)<br />tim(202154508:54.@past.@entry,     115168790:88)<br />man(201904930:71,     600000565:59)<br />{/unl}<br />[/S]<br /><br />[S:375525]<br />{org:fr}<br />Les hommes, dit le petit prince, ils s’enfournent dans les rapides, mais ils ne savent plus ce qu’ils cherchent.<br />{/org}<br />{ar}<br />أمير صغير قال حشر بشر نفسهم في القطارات سريعة ولكن لم يعد عرف بحث<br />{/ar}<br />{ar}<br />قال أمير صغير حشر ناس نفسهم في القطارات سريعة ولكن لم يعد عرف فحص  <br />{/ar}<br />{unl}<br />agt(500324405:44,     201009240:16.@past.@entry)<br />agt(202094569:51.@reflexive.@speech,     102472987:94.@generic)<br />plc(202094569:51.@reflexive.@speech,     103306385:67.@pl.@def)<br />obj(201009240:16.@past.@entry,     202094569:51.@reflexive.@speech)<br />mod(200594621:58.@but,     400031515:27)<br />aoj(200594621:58.@but,     102472987:94.@generic)<br />and(200594621:58.@but,     202094569:51.@reflexive.@speech)<br />obj(200594621:58.@but,     201315613:84)<br />agt(201315613:84,     102472987:94.@generic)<br />{/unl}<br />[/S]<br /><br />[S:375526]<br />{org:fr}<br />Alors ils s’agitent et tournent en rond (pds) .<br />{/org}<br />{ar}<br />يلتفت البالغون دائري و هم متحمسون <br />{/ar}<br />{ar}<br />البالغون يلتفتوا دائري وهم متحمسون<br />{/ar}<br />{unl}<br />aoj(300919542:19.@entry,     109605289:94.@def.@pl)<br />agt(201907258:84.@present,     109605289:94.@def.@pl)<br />and(201907258:84.@present,     300919542:19.@entry)<br />man(201907258:84.@present,     302040652:69)<br />{/unl}<br />[/S]<br /><br />[S:375527]<br />{org:fr}<br />Et il ajouta:<br />{/org}<br />{ar}<br />أمير صغير  و أضاف <br />{/ar}<br />{ar}<br />وأضاف أمير صغير<br />{/ar}<br />{unl}<br />agt(201027174:67.@past.@entry,     500324405:86)<br />and(201027174:67.@past.@entry,     600000565:20)<br />{/unl}<br />[/S]<br /><br />[S:375528]<br />{org:fr}<br />Ce n’est pas la peine (pds).<br />{/org}<br />{ar}<br />ليس ذو قيمة<br />{/ar}<br />{unl}<br />aoj(302587738:41.@not.@present.@hesitation.@entry,     600000565:97)<br />{/unl}<br />[/S]<br /><br />[S:375529]<br />{org:fr}<br />Le puits que nous avions atteint ne ressemblait pas aux puits sahariens.<br />{/org}<br />{ar}<br />نحن تحققنا البئر لم يشبه آبار صحراوية<br />{/ar}<br />{ar}<br />تحققنا البئر لم يشبه آبار صحراوية<br />{/ar}<br />{unl}<br />aoj(202665617:81.@not.@past.@imperfective.@entry,     104572344:10.@def)<br />agt(202526085:93.@past.@anterior.@relative,     600000565:89.@1.@pl)<br />obj(202526085:93.@past.@anterior.@relative,     104572344:10.@def)<br />mod(104572344:17.@pl,     302791735:26)<br />obj(202665617:81.@not.@past.@imperfective.@entry,     104572344:17.@pl)<br />{/unl}<br />[/S]<br /><br />[S:375530]<br />{org:fr}<br />Les puits sahariens sont de simples trous creusés dans le sable.<br />{/org}<br />{ar}<br />الآبار صحراوية الذي حفرثقوب بسيطة في الرمل<br />{/ar}<br />{unl}<br />mod(104572344:91.@pl.@def,     302791735:13)<br />aoj(103526198:49.@pl.@indef.@entry,     104572344:91.@pl.@def)<br />mod(103526198:49.@pl.@indef.@entry,     302174896:65)<br />obj(201309701:12.@relative,     103526198:49.@pl.@indef.@entry)<br />plc(201309701:12.@relative,     115019030:61.@def)<br />{/unl}<br />[/S]<br /><br />[S:375531]<br />{org:fr}<br />Celui-là ressemblait à un puits de village.<br />{/org}<br />{ar}<br />ذلك مثل بئر قرية<br />{/ar}<br />{unl}<br />aoj(104572344:80.@indef.@like.@past.@imperfective.@entry,     600000565:13.@distal)<br />mod(104572344:80.@indef.@like.@past.@imperfective.@entry,     108226699:29)<br />{/unl}<br />[/S]<br /><br />[S:375532]<br />{org:fr}<br />C’est un avion.<br />{/org}<br />{ar}<br />هذه طائرة<br />{/ar}<br />{unl}<br />aoj(102691156:14.@generic.@entry,     600000565:68.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375533]<br />{org:fr}<br />Mais il n’y avait là aucun village, et je croyais rêver.<br />{/org}<br />{ar}<br />لكن كانت أي قرية هناك وظن حلم<br />{/ar}<br />{ar}<br />لكن أي قرية كانت هناك وزعم حلم<br />{/ar}<br />{unl}<br />aoj(202749904:95.@past.@imperfective.@but,     108672738:36.@any)<br />plc(202749904:95.@past.@imperfective.@but,     600000565:78.@distal)<br />and(202749904:95.@past.@imperfective.@but,     600000565:20)<br />aoj(201637633:98.@belief.@past.@imperfective.@entry,     600000565:39)<br />and(201637633:98.@belief.@past.@imperfective.@entry,     202749904:95.@past.@imperfective.@but)<br />{/unl}<br />[/S]<br /><br />[S:375534]<br />{org:fr}<br />C’est étrange, dis-je au petit prince, tout est prêt:<br />{/org}<br />{ar}<br />غريب أنا قلت لأمير صغير كل شيء جاهز<br />{/ar}<br />{ar}<br />غريب قلت لأمير صغير كل شيء يستعد<br />{/ar}<br />{unl}<br />aoj(300967129:17.@present.@topic.@speech,     600000565:95)<br />obj(201009240:54.@past.@entry,     600000565:95)<br />agt(201009240:54.@past.@entry,     600000565:51.@1)<br />aoj(301930512:18.@present.@speech,     600000565:42.@every.@thing)<br />gol(201009240:54.@past.@entry,     500324405:52)<br />obj(201009240:54.@past.@entry,     301930512:18.@present.@speech)<br />{/unl}<br />[/S]<br /><br />[S:375535]<br />{org:fr}<br />la poulie, le seau et la corde (pds).<br />{/org}<br />{ar}<br />البكرة والدلو والحبل<br />{/ar}<br />{ar}<br />البكرة والسطل والحبل<br />{/ar}<br />{unl}<br />and(104108268:81.@def.@entry,     102909870:89.@def)<br />and(102909870:89.@def,     104020298:79.@def)<br />{/unl}<br />[/S]<br /><br />[S:375536]<br />{org:fr}<br />Il rit, toucha la corde, fit jouer la poulie.<br />{/org}<br />{ar}<br />أمير صغير ضحك ثم لمس ثم حفز عمل البكرة  <br />{/ar}<br />{ar}<br />ضحك أمير صغير ثم لمس ثم حفز عمل البكرة<br />{/ar}<br />{unl}<br />agt(200031820:49.@past,     500324405:66)<br />agt(201206218:13.@past,     500324405:66)<br />agt(200770437:55.@past.@entry,     500324405:66)<br />obj(201903562:33,     104020298:56.@def)<br />obj(200770437:55.@past.@entry,     201903562:33)<br />seq(200770437:55.@past.@entry,     201206218:13.@past)<br />seq(201206218:13.@past,     200031820:49.@past)<br />{/unl}<br />[/S]<br /><br />[S:375537]<br />{org:fr}<br />Et la poulie gémit comme gémit une vieille girouette quand le vent a longtemps dormi.<br />{/org}<br />{ar}<br />وبكى البكرة مثل دوارة الرياح قديمة في الريح نام لمدة طويلة<br />{/ar}<br />{unl}<br />obj(200066025:36.@past.@entry,     104020298:48.@def)<br />man(200066025:36.@past.@entry,     104568069:17.@indef.@like)<br />mod(104568069:17.@indef.@like,     301638438:13)<br />tim(200066025:36.@past.@entry,     200014742:19.@past)<br />aoj(200014742:19.@past,     111525955:85.@def)<br />mod(200014742:19.@past,     400166025:43)<br />and(200066025:36.@past.@entry,     600000565:56)<br />{/unl}<br />[/S]<br /><br />[S:375538]<br />{org:fr}<br />Tu entends, dit le petit prince, nous réveillons ce puits et il chante (pds).<br />{/org}<br />{ar}<br />أمير صغير قال أنت سمعت نحن نصحي ونغني هذا البئر<br />{/ar}<br />{ar}<br />قال أمير صغير أنت سمعت نحن نصحي ونغني هذا البئر<br />{/ar}<br />{unl}<br />aoj(202169702:75.@speech.@hesitation,     600000565:88.@2)<br />agt(201009240:82.@past.@entry,     500324405:43)<br />obj(201009240:82.@past.@entry,     202169702:75.@speech.@hesitation)<br />agt(200018813:59.@present.@speech,     600000565:42.@1.@pl)<br />obj(201009240:82.@past.@entry,     200018813:59.@present.@speech)<br />obj(200018813:59.@present.@speech,     104572344:57.@proximal)<br />obj(202169702:75.@speech.@hesitation,     200018813:59.@present.@speech)<br />agt(201729431:94.@present,     104572344:57.@proximal)<br />and(201729431:94.@present,     200018813:59.@present.@speech)<br />{/unl}<br />[/S]<br /><br />[S:375539]<br />{org:fr}<br />Je ne voulais pas qu’il fît un effort:<br />{/org}<br />{ar}<br />أنا لم أريد أمير صغير فعل محاولة <br />{/ar}<br />{ar}<br />أنا لم أريد أمير صغير فعل جهد <br />{/ar}<br />{ar}<br />أنا لم أرغب في أمير صغير عمل محاولة<br />{/ar}<br />{ar}<br />أنا لم أرغب في أمير صغير عمل جهد<br />{/ar}<br />{ar}<br />أنا لم أريد أمير صغير عمل محاولة <br />{/ar}<br />{unl}<br />aoj(201825237:47.@past.@imperfective.@not.@entry,     600000565:33.@1)<br />obj(202560585:12.@subjective.@past.@imperfective,     100786195:22.@indef)<br />obj(201825237:47.@past.@imperfective.@not.@entry,     202560585:12.@subjective.@past.@imperfective)<br />agt(202560585:12.@subjective.@past.@imperfective,     500324405:60)<br />{/unl}<br />[/S]<br /><br />[S:375540]<br />{org:fr}<br />Laisse-moi faire, lui dis-je, c’est trop lourd pour toi.<br />{/org}<br />{ar}<br />أنا أقول أنت اسمحني بأدى لإن الدلو مثقل عديد لأنت أمير صغير <br />{/ar}<br />{ar}<br />أنا أقول أمير صغير أنت اسمحني بأدى لإن الدلو مثقل عديد لأنت<br />{/ar}<br />{ar}<br />أنا أقول أمير صغير أنت اسمحني بأدى لإن الدلو مثقل كثير لأنت<br />{/ar}<br />{ar}<br />أنا أقول أمير صغير أنت اسمحني بقام بسبب أن الدلو مثقل كثير لأنت<br />{/ar}<br />{ar}<br />أنا أقول أنت اسمحني بقام بسبب أن الدلو مثقل عديد لأنت أمير صغير<br />{/ar}<br />{unl}<br />agt(201009240:39.@present.@entry,     600000565:19.@1)<br />gol(201009240:39.@present.@entry,     500324405:87)<br />aoj(301188762:55.@multal,     102909870:70.@def)<br />gol(301188762:55.@multal,     500324405:87)<br />aoj(202423183:54.@imperative,     600000565:48.@2.@ellipsis)<br />gol(202423183:54.@imperative,     600000565:19.@1)<br />obj(202423183:54.@imperative,     201712704:58)<br />obj(201009240:39.@present.@entry,     202423183:54.@imperative)<br />rsn(202423183:54.@imperative,     301188762:55.@multal)<br />mod(301188762:55.@multal,     600000565:14.@2.@for)<br />{/unl}<br />[/S]<br /><br />[S:375541]<br />{org:fr}<br />Lentement je hissai le seau jusqu’à la margelle.<br />{/org}<br />{ar}<br />أنا رفعت البئر إلى حد ببطء<br />{/ar}<br />{ar}<br />أنا رفعت البئر إلى حد بتمهل<br />{/ar}<br />{unl}<br />agt(201974062:27.@past.@entry,     600000565:34.@1)<br />man(201974062:27.@past.@entry,     400161630:48)<br />obj(201974062:27.@past.@entry,     104572344:56.@def)<br />plt(201974062:27.@past.@entry,     108565701:16)<br />{/unl}<br />[/S]<br /><br />[S:375542]<br />{org:fr}<br />Je l’y installai bien d’aplomb.<br />{/org}<br />{ar}<br />أنا وضعت الدلو في حد البئر رأسيا <br />{/ar}<br />{ar}<br />أنا وضعت السطل في حد البئر رأسيا <br />{/ar}<br />{ar}<br />أنا وضعت الدلو في حد البئر عموديا <br />{/ar}<br />{ar}<br />أنا وضعت الدلو عموديا في حد البئر<br />{/ar}<br />{ar}<br />أنا وضعت الدلو رأسيا في حد البئر<br />{/ar}<br />{unl}<br />mod(108565701:48.@def,     104572344:92)<br />agt(201494310:36.@past.@entry,     600000565:74.@1)<br />plc(201494310:36.@past.@entry,     108565701:48.@def)<br />man(201494310:36.@past.@entry,     400490798:64)<br />mod(400490798:64,     400018781:49)<br />obj(201494310:36.@past.@entry,     102909870:50.@def)<br />{/unl}<br />[/S]<br /><br />[S:375543]<br />{org:fr}<br />C’est mon avion.<br />{/org}<br />{ar}<br />تكون طائرتي<br />{/ar}<br />{unl}<br />aoj(102691156:96.@present.@entry,     600000565:15)<br />pos(102691156:96.@present.@entry,     600000565:74.@1)<br />{/unl}<br />[/S]<br /><br />[S:375544]<br />{org:fr}<br />Dans mes oreilles durait le chant de la poulie et, dans l’eau qui tremblait encore, je voyais trembler le soleil.<br />{/org}<br />{ar}<br />الغناء البكرة دام في آذاني ورأيت شمس رعشت في الماء الذي ارتعش دون توقف <br />{/ar}<br />{ar}<br />غناء البكرة دام في آذاني ورأيت شمس رعشت في الماء الذي ارتعش دون توقف <br />{/ar}<br />{ar}<br />دام الغناء البكرة في آذاني ورأيت شمس رعشت في الماء الذي ارتعش دون توقف<br />{/ar}<br />{ar}<br />دام غناء البكرة في آذاني ورأيت شمس رعشت في الماء الذي ارتعش دون توقف<br />{/ar}<br />{ar}<br />دام غناء البكرة في آذاني ورأيت شمس رعشت في الماء الذي ارتعش دون انقطاع<br />{/ar}<br />{unl}<br />agt(202129289:82.@past.@imperfective,     600000565:10.@1)<br />obj(202129289:82.@past.@imperfective,     109450163:69)<br />agt(201888511:13,     109450163:69)<br />plc(202129289:82.@past.@imperfective,     114845743:67.@def)<br />agt(201888511:89.@past.@imperfective.@relative,     114845743:67.@def)<br />man(201888511:89.@past.@imperfective.@relative,     400031304:27)<br />pos(105320899:33.@pl,     600000565:10.@1)<br />plc(202704928:40.@past.@imperfective.@entry,     105320899:33.@pl)<br />aoj(202704928:40.@past.@imperfective.@entry,     107394588:73.@def)<br />mod(107394588:73.@def,     104020298:81.@def)<br />and(202129289:82.@past.@imperfective,     202704928:40.@past.@imperfective.@entry)<br />{/unl}<br />[/S]<br /><br />[S:375545]<br />{org:fr}<br />J’ai soif de cette eau-là, dit le petit prince, donne-moi à boire (pds).<br />{/org}<br />{ar}<br />أمير صغير يقول أنا لدي عطش هذا الماء وأعطي شرب<br />{/ar}<br />{ar}<br />يقول أمير صغير أنا لدي عطش هذا الماء وأعطي شرب<br />{/ar}<br />{ar}<br />أمير صغير يقول أنا أمتلك عطش هذا الماء وأعطي شرب<br />{/ar}<br />{ar}<br />يقول أمير صغير أنا أمتلك عطش هذا الماء وأعطي شرب<br />{/ar}<br />{unl}<br />agt(201009240:63.@present.@entry,     500324405:90)<br />obj(201009240:63.@present.@entry,     202203362:67.@present.@speech)<br />and(202199590:22.@imperative.@present.@speech,     202203362:67.@present.@speech)<br />obj(201009240:63.@present.@entry,     202199590:22.@imperative.@present.@speech)<br />obj(202199590:22.@imperative.@present.@speech,     201170052:28)<br />aoj(202203362:67.@present.@speech,     600000565:77.@1)<br />obj(202203362:67.@present.@speech,     114040660:59)<br />obj(114040660:59,     114845743:33.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375546]<br />{org:fr}<br />Et je compris ce qu’il avait cherché!<br />{/org}<br />{ar}<br />أنا أفهم أمير صغير بحث!<br />{/ar}<br />{unl}<br />aoj(200591115:67.@exclamation.@past.@entry,     600000565:28.@1)<br />agt(201315613:17.@past.@anterior,     500324405:82)<br />obj(200591115:67.@exclamation.@past.@entry,     201315613:17.@past.@anterior)<br />obj(201315613:17.@past.@anterior,     600000565:93)<br />{/unl}<br />[/S]<br /><br />[S:375547]<br />{org:fr}<br />Je soulevai le seau jusqu’à ses lèvres.<br />{/org}<br />{ar}<br />أنا رفعت الدلو شفاه أمير صغير<br />{/ar}<br />{ar}<br />أنا رفعت السطل شفاه أمير صغير<br />{/ar}<br />{unl}<br />agt(201974062:17.@past.@entry,     600000565:60.@1)<br />obj(201974062:17.@past.@entry,     102909870:47.@def)<br />pos(105305806:19.@pl,     500324405:89)<br />gol(201974062:17.@past.@entry,     105305806:19.@pl)<br />{/unl}<br />[/S]<br /><br />[S:375548]<br />{org:fr}<br />Il but, les yeux fermés.<br />{/org}<br />{ar}<br />أمير صغير شرب بعيون مغلقة<br />{/ar}<br />{ar}<br />شرب أمير صغير بعيون مغلقة<br />{/ar}<br />{unl}<br />agt(201170052:62.@past.@entry,     500324405:67)<br />man(201170052:62.@past.@entry,     105311054:30.@pl)<br />mod(105311054:30.@pl,     301653538:93)<br />{/unl}<br />[/S]<br /><br />[S:375549]<br />{org:fr}<br />C’était doux comme une fête.<br />{/org}<br />{ar}<br />هذا الماء كان حلو حفلة<br />{/ar}<br />{ar}<br />هذا الماء كان محلى حفلة<br />{/ar}<br />{ar}<br />هذا الماء كان محلى مهرجان<br />{/ar}<br />{ar}<br />هذا الماء كان محلى عيد<br />{/ar}<br />{ar}<br />هذا الماء كان حلو مهرجان<br />{/ar}<br />{unl}<br />aoj(302368336:73.@entry.@past.@imperfective,     114845743:43.@proximal)<br />man(302368336:73.@entry.@past.@imperfective,     100517728:88.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375550]<br />{org:fr}<br />Cette eau était bien autre chose qu’un aliment.<br />{/org}<br />{ar}<br />هذا الماء ليس غذاء<br />{/ar}<br />{ar}<br />هذا الماء ليس أطعمة<br />{/ar}<br />{ar}<br />هذا الماء ليس مأكل<br />{/ar}<br />{ar}<br />هذا الماء ليس مأكولات<br />{/ar}<br />{ar}<br />هذا الماء لا غذاء<br />{/ar}<br />{unl}<br />aoj(100021265:91.@indef.@not.@entry,     114845743:55.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:375551]<br />{org:fr}<br />Elle était née de la marche sous les étoiles, du chant de la poulie, de l’effort de mes bras.<br />{/org}<br />{ar}<br />هذا الماء ولد من المشي تحت نجوم من غناء البكرة من محاولة أذرعي <br />{/ar}<br />{ar}<br />هذا الماء ولد من المشي تحت نجوم من غناء البكرة من محاولتي أذرع<br />{/ar}<br />{ar}<br />ولد هذا الماء من المشي تحت نجوم من غناء البكرة من محاولة أذرعي <br />{/ar}<br />{ar}<br />ولد هذا الماء من المشي تحت نجوم من غناء البكرة من محاولتي أذرع<br />{/ar}<br />{unl}<br />aoj(200360932:55.@past.@anterior.@entry,     114845743:51.@proximal)<br />src(200360932:55.@past.@anterior.@entry,     100283568:27.@def)<br />plc(100283568:27.@def,     109444100:65.@pl.@under)<br />src(200360932:55.@past.@anterior.@entry,     100546389:72.@def)<br />mod(100546389:72.@def,     104020298:24)<br />src(200360932:55.@past.@anterior.@entry,     100786195:39)<br />mod(100786195:39,     105563770:26.@pl)<br />pos(100786195:39,     600000565:78.@1)<br />{/unl}<br />[/S]<br /><br />[S:375552]<br />{org:fr}<br />Elle était bonne pour le cœur, comme un cadeau.<br />{/org}<br />{ar}<br />الماء كان جيد القلب أهدى<br />{/ar}<br />{ar}<br />الماء كان حسن القلب أهدى<br />{/ar}<br />{ar}<br />كان الماء جيد القلب أهدى<br />{/ar}<br />{ar}<br />كان الماء حسن القلب أهدى<br />{/ar}<br />{unl}<br />aoj(301123148:76.@past.@imperfective.@entry,     114845743:39.@def)<br />gol(301123148:76.@past.@imperfective.@entry,     105919263:13.@def)<br />mod(105919263:13.@def,     202200686:52.@indef)<br />{/unl}<br />[/S]<br /><br />[S:375553]<br />{org:fr}<br />Lorsque j’étais petit garçon, la lumière de l’arbre de Noël, la musique de la messe de minuit, la douceur des sourires faisaient ainsi tout le rayonnement du cadeau de Noël que je recevais.<br />{/org}<br />{ar}<br />الضوء الشجرة الميلاد والموسيقى القداس العيد ميلاد والرقة الابتسامات شكل البريق الهدية كريسماس في أنا كنت ولد  <br />{/ar}<br />{ar}<br />ضوء الشجرة الميلاد وموسيقى قداس العيد ميلاد ورقة الابتسامات شكل بريق الهدية كريسماس في أنا كنت ولد<br />{/ar}<br />{ar}<br /> شكل الضوء الشجرة الميلاد والموسيقى القداس العيد ميلاد والرقة الابتسامات البريق الهدية كريسماس في أنا كنت ولد<br />{/ar}<br />{ar}<br />شكل ضوء الشجرة الميلاد وموسيقى قداس العيد ميلاد ورقة الابتسامات بريق الهدية كريسماس في أنا كنت ولد<br />{/ar}<br />{unl}<br />aoj(110285313:91.@past.@imperfective,     600000565:38.@1)<br />aoj(202620587:39.@past.@imperfective.@entry,     111473954:40.@def)<br />obj(202620587:39.@past.@imperfective.@entry,     104953954:54.@def)<br />mod(104953954:54.@def,     113269186:92.@def)<br />mod(111473954:40.@def,     103026626:30.@def)<br />tim(202620587:39.@past.@imperfective.@entry,     110285313:91.@past.@imperfective)<br />and(107020895:34.@def,     111473954:40.@def)<br />mod(101042242:13.@def,     115196186:88)<br />mod(107020895:34.@def,     101042242:13.@def)<br />and(104627241:35.@def,     107020895:34.@def)<br />mod(104627241:35.@def,     106878071:62.@def.@pl)<br />{/unl}<br />[/S]<br /><br />[S:375554]<br />{org:fr}<br />Et j’étais fier de lui apprendre que je volais.<br />{/org}<br />{ar}<br />وكنت فخور أمير صغير اكتشف أنا كنت أطير <br />{/ar}<br />{ar}<br />وأنا كنت فخور بأمير صغير اكتشف أنا كنت أطير    <br />{/ar}<br />{ar}<br />وأنا كنت فخور أمير صغير باكتشف أنا كنت أطير<br />{/ar}<br />{unl}<br />aoj(301889256:15.@past.@imperfective.@entry,     600000565:73.@1)<br />obj(301889256:15.@past.@imperfective.@entry,     200598954:54)<br />aoj(200598954:54,     500324405:41)<br />agt(201940403:61.@past.@imperfective,     600000565:73.@1)<br />obj(200598954:54,     201940403:61.@past.@imperfective)<br />and(301889256:15.@past.@imperfective.@entry,     600000565:13)<br />{/unl}<br />[/S]<br /><br />[S:375555]<br />{org:fr}<br />Les hommes de chez toi, dit le petit prince, cultivent cinq mille roses dans un même jardin (pds).<br />{/org}<br />{ar}<br />أمير صغير قال الناس من أنت مكان ينتج 5000 ورد في نفس حديقة<br />{/ar}<br />{ar}<br /> قال أمير صغير الناس من أنت مكان ينتج 5000 ورد في نفس حديقة<br />{/ar}<br />{ar}<br />قال أمير صغير الناس من أنت مكان ينتج خمسة آلاف ورد في نفس حديقة<br />{/ar}<br />{ar}<br />قال أمير صغير الناس من أنت مكان ينتج خمسة آلاف وردة في نفس حديقة<br />{/ar}<br />{ar}<br />قال أمير صغير أن الناس من أنت مكان ينتج خمسة آلاف وردة في نفس حديقة<br />{/ar}<br />{unl}<br />src(107942152:24.@pl.@def,     108559508:39)<br />pos(600000565:42.@2,     108559508:39)<br />agt(201009240:51.@past.@entry,     500324405:44)<br />agt(201739814:73.@present.@hesitation,     107942152:24.@pl.@def)<br />obj(201009240:51.@past.@entry,     201739814:73.@present.@hesitation)<br />obj(201739814:73.@present.@hesitation,     112620196:98.@pl)<br />qua(112620196:98.@pl,     &quot;5000&quot;:22)<br />plc(201739814:73.@present.@hesitation,     103417345:30.@same)<br />{/unl}<br />[/S]<br /><br />[S:375556]<br />{org:fr}<br />et ils n’y trouvent pas ce qu’ils cherchent.<br />{/org}<br />{ar}<br />وناس لا يكتشفون يبحثون في حديقة <br />{/ar}<br />{ar}<br />ولا يكتشفون ناس يبحثون في حديقة <br />{/ar}<br />{ar}<br />ولا يكتشفون بشر يبحثون في حديقة<br />{/ar}<br />{ar}<br />ولا يكتشفون بشر يبحثون في بستان<br />{/ar}<br />{ar}<br />ولا يكتشفون ناس يبحثون في بستان<br />{/ar}<br />{unl}<br />agt(202154508:49.@not.@present.@entry,     107942152:35)<br />obj(202154508:49.@not.@present.@entry,     201315613:39.@present)<br />agt(201315613:39.@present,     107942152:35)<br />plc(202154508:49.@not.@present.@entry,     103417345:42)<br />and(202154508:49.@not.@present.@entry,     600000565:78)<br />{/unl}<br />[/S]<br /><br />[S:375557]<br />{org:fr}<br />Ils ne le trouvent pas, répondis-je (pds).<br />{/org}<br />{ar}<br />أنا جاوبت بشر لم يكتشفوا بحثوا<br />{/ar}<br />{ar}<br />أنا أجبت بشر لم يكتشفوا بحثوا<br />{/ar}<br />{unl}<br />agt(202154508:94.@not.@speech,     107942152:37)<br />agt(201315613:19,     107942152:37)<br />obj(202154508:94.@not.@speech,     201315613:19)<br />obj(200815686:74.@past.@hesitation.@entry,     202154508:94.@not.@speech)<br />agt(200815686:74.@past.@hesitation.@entry,     600000565:64.@1)<br />{/unl}<br />[/S]<br /><br