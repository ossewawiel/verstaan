tive.@entry,     112102133:11.@def)<br />and(200447771:10.@past.@imperfective,     202139544:76.@past.@imperfective.@entry)<br />aoj(200447771:10.@past.@imperfective,     111669921:18.@def.@pl)<br />tim(200447771:10.@past.@imperfective,     115167027:33)<br />{/unl}<br />[/S]<br /><br />[S:376126]<br />{org:fr}<br />Mais celle-là avait germé un jour, d’une graine apportée d’on ne sait où, et le petit prince avait surveillé de très près cette brindille qui ne ressemblait pas aux autres brindilles.<br />{/org}<br />{ar}<br />أمير صغير شاهد البرعم لم بدا نفسه للبراعم الأخرى عن قرب جدا و لكن تلك الزهرة أنبتت في مرة من بذرة أحضرت من عرف<br />{/ar}<br />{ar}<br />شاهد أمير صغير عن قرب جدا البرعم لم بدا نفسه للبراعم الأخرى و لكن تلك الزهرة أنبتت في مرة من بذرة أحضرت من عرف<br />{/ar}<br />{ar}<br />شاهد أمير صغير عن قرب جدا البرعم لم بدا نفسه للبراعم الأخرى و لكن في مرة تلك الزهرة أنبتت من بذرة أحضرت  من عرف<br />{/ar}<br />{unl}<br />aoj(200357332:69.@past.@anterior.@but,     111669921:84.@distal)<br />tim(200357332:69.@past.@anterior.@but,     400118869:56)<br />and(200357332:69.@past.@anterior.@but,     600000565:88)<br />src(200357332:69.@past.@anterior.@but,     111683989:99.@indef)<br />obj(201433294:93.@passive,     111683989:99.@indef)<br />plc(201433294:93.@passive,     600000565:85.@some.@from)<br />aoj(200594621:81,     600000565:25)<br />obj(200594621:81,     600000565:85.@some.@from)<br />aoj(202150510:67.@past.@anterior.@entry,     500324405:59)<br />obj(202150510:67.@past.@anterior.@entry,     107719437:73.@proximal)<br />and(202150510:67.@past.@anterior.@entry,     200357332:69.@past.@anterior.@but)<br />mod(400505226:43,     400031899:23)<br />man(202150510:67.@past.@anterior.@entry,     400505226:43)<br />aoj(202665617:48.@not.@past.@imperfective.@reflexive,     107719437:73.@proximal)<br />gol(202665617:48.@not.@past.@imperfective.@reflexive,     107719437:61.@pl.@other.@def)<br />{/unl}<br />[/S]<br /><br />[S:376127]<br />{org:fr}<br />Ça pouvait être un nouveau genre de baobab.<br />{/org}<br />{ar}<br />هذا النوع لاحظ نوع شجرة استوائية جديدة<br />{/ar}<br />{ar}<br />لاحظ هذا النوع نوع جديدة شجرة استوائية<br />{/ar}<br />{unl}<br />aoj(105839024:49.@indef.@imperfective.@past.@possibility.@entry,     200329654:84.@proximal)<br />obj(105839024:49.@indef.@imperfective.@past.@possibility.@entry,     105839024:90.@indef)<br />mod(105839024:90.@indef,     301640850:53)<br />mod(105839024:90.@indef,     112189987:79)<br />{/unl}<br />[/S]<br /><br />[S:376128]<br />{org:fr}<br />Mais l’arbuste cessa vite de croître, et commença de préparer une fleur.<br />{/org}<br />{ar}<br />الشجيرة بدأت أعدت زهرة و الشجيرة نمت بسرعة<br />{/ar}<br />{ar}<br />بدأت الشجيرة أعدت زهرة و الشجيرة بسرعة نمت<br />{/ar}<br />{unl}<br />aoj(200231557:41.@terminative.@past,     113112664:91.@def)<br />man(200231557:41.@terminative.@past,     400085811:11)<br />agt(200406243:86.@inceptive.@entry,     113112664:91.@def)<br />and(200406243:86.@inceptive.@entry,     200231557:41.@terminative.@past)<br />obj(200406243:86.@inceptive.@entry,     111669921:60.@indef)<br />{/unl}<br />[/S]<br /><br />[S:376129]<br />{org:fr}<br />Le petit prince, qui assistait à l’installation d’un bouton énorme, sentait bien qu’il en sortirait une apparition miraculeuse, mais la fleur n’en finissait pas de se préparer à être belle, à l’abri de sa chambre verte.<br />{/org}<br />{ar}<br />أمير صغير الذي شاهد ظهور برعم ضخم شعر بظهور مدهش ظهر بشكل جيد و لكن لم استكملت زهرة المأوى الأخضر أعد جمل في المأوى الأخضر<br />{/ar}<br />{ar}<br />أمير صغير الذي شاهد ظهور برعم كبير أحس بشكل جيد بظهور مدهش ظهر و لكن لم استكملت في المأوى الأخضر زهرة المأوى الأخضر أعد جمل<br />{/ar}<br />{unl}<br />aoj(201771535:17.@past.@imperfective.@entry,     500324405:62)<br />agt(202150510:68.@past.@imperfective.@relative,     500324405:62)<br />obj(202150510:68.@past.@imperfective.@relative,     100050195:36)<br />mod(100050195:36,     111674914:16.@indef)<br />mod(111674914:16.@indef,     301387319:65)<br />mod(100050484:43.@indef,     301576551:96)<br />obj(201771535:17.@past.@imperfective.@entry,     201990694:10.@past.@posterior.@relative)<br />man(201771535:17.@past.@imperfective.@entry,     400012779:53)<br />aoj(200484166:64.@past.@imperfective.@not.@but,     111669921:20.@def)<br />obj(200484166:64.@past.@imperfective.@not.@but,     200406243:98.@reflexive)<br />and(200484166:64.@past.@imperfective.@not.@but,     201771535:17.@past.@imperfective.@entry)<br />obj(200406243:98.@reflexive,     200293141:69)<br />plc(200293141:69,     104191595:27.@def)<br />mod(104191595:27.@def,     300375969:60)<br />pos(104191595:27.@def,     111669921:20.@def)<br />obj(201990694:10.@past.@posterior.@relative,     100050484:43.@indef)<br />{/unl}<br />[/S]<br /><br />[S:376130]<br />{org:fr}<br />Elle choisissait avec soin ses couleurs.<br />{/org}<br />{ar}<br />الزهرة اختارت ألوان الزهرة بعناية<br />{/ar}<br />{ar}<br />اختارت الزهرة ألوان الزهرة بحذر<br />{/ar}<br />{ar}<br />اختارت الزهرة بعناية ألوان الزهرة<br />{/ar}<br />{unl}<br />agt(200674607:79.@past.@imperfective.@entry,     111669921:44.@def)<br />man(200674607:79.@past.@imperfective.@entry,     400153568:20)<br />obj(200674607:79.@past.@imperfective.@entry,     104956594:29.@pl)<br />pos(104956594:29.@pl,     111669921:44.@def)<br />{/unl}<br />[/S]<br /><br />[S:376131]<br />{org:fr}<br />Elle s’habillait lentement, elle ajustait un à un ses pétales.<br />{/org}<br />{ar}<br />لبست الزهرة ببطء انسجمت الزهرة مع بتلات كل بتلة بشكل منفرد<br />{/ar}<br />{ar}<br />الزهرة لبست ببطء الزهرة انسجمت  مع بتلات كل بتلة كل على حده<br />{/ar}<br />{unl}<br />agt(200046534:42.@past.@imperfective.@reflexive.@entry,     111669921:88.@def)<br />man(200046534:42.@past.@imperfective.@reflexive.@entry,     400161630:14)<br />agt(200150287:68.@past.@imperfective,     111669921:88.@def)<br />obj(200150287:68.@past.@imperfective,     111690455:71.@pl)<br />mod(111690455:46,     600000848:38)<br />mod(111690455:46,     111690455:71.@pl)<br />mod(111690455:46,     400207668:50)<br />pos(111690455:71.@pl,     111669921:88.@def)<br />{/unl}<br />[/S]<br /><br />[S:376132]<br />{org:fr}<br />Elle ne voulait pas sortir toute fripée comme les coquelicots.<br />{/org}<br />{ar}<br />ليت الزهرة لم خرجت مجعدة خشخاش بالكامل<br />{/ar}<br />{unl}<br />agt(202015598:60.@past.@imperfective.@desire.@not.@entry,     111669921:68.@def)<br />aoj(302425220:41,     111669921:68.@def)<br />mod(302425220:41,     400008007:80)<br />mod(302425220:41,     111900569:12.@pl)<br />{/unl}<br />[/S]<br /><br />[S:376133]<br />{org:fr}<br />Elle ne voulait apparaître que dans le plein rayonnement de sa beauté.<br />{/org}<br />{ar}<br />فقط ليت الزهرة حسناء ظهرت بتألق جمال تام<br />{/ar}<br />{ar}<br />ليت فقط الزهرة الحسناء ظهرت بتألق جمال كامل<br />{/ar}<br />{unl}<br />agt(202139544:44.@past.@imperfective.@desire.@entry.@only,     111669921:63.@def)<br />pos(104683814:12,     111669921:63.@def)<br />mod(114051201:62,     300515380:86)<br />mod(114051201:62,     104683814:12)<br />man(202139544:44.@past.@imperfective.@desire.@entry.@only,     114051201:62)<br />{/unl}<br />[/S]<br /><br />[S:376134]<br />{org:fr}<br />Eh!<br />{/org}<br />{ar}<br />بتردد!<br />{/ar}<br />{unl}<br />[W]<br />600000565:26.@hesitation.@exclamation.@entry<br />[/W]<br />{/unl}<br />[/S]<br /><br />[S:376135]<br />{org:fr}<br />J’ai ainsi eu, au cours de ma vie, des tas de contacts avec des tas de gens sérieux.<br />{/org}<br />{ar}<br />أنا لدي اتصالات كثيرة أشخاص كثيرة جادة في طريق حياتي<br />{/ar}<br />{ar}<br />لدي اتصالات كثيرة أشخاص جادة كثيرة في طريق حياتي<br />{/ar}<br />{unl}<br />mod(100039297.@generic.@multal,     100007846.@generic.@multal)<br />obj(202203362.@entry.@past,     100039297.@generic.@multal)<br />tim(202203362.@entry.@past,     109387222.@def)<br />mod(109387222.@def,     115140744.@def)<br />aoj(202203362.@entry.@past,     600000565.@1)<br />mod(115140744.@def,     600000565.@1)<br />mod(100007846.@generic.@multal,     302118379)<br />{/unl}<br />[/S]<br /><br />[S:376136]<br />{org:fr}<br />Elle était très coquette!<br />{/org}<br />{ar}<br />الزهرة مغازلة جدا<br />{/ar}<br />{ar}<br />الزهرة لعوبة جدا<br />{/ar}<br />{unl}<br />mod(302131958:60.@past.@imperfective.@exclamation.@entry,     400031899:68)<br />aoj(302131958:60.@past.@imperfective.@exclamation.@entry,     111669921:83.@def)<br />{/unl}<br />[/S]<br /><br />[S:376137]<br />{org:fr}<br />Sa toilette mystérieuse avait donc duré des jours et des jours.<br />{/org}<br />{ar}<br />لذا دام تزين الزهرة الغامض في أيام و أيام<br />{/ar}<br />{ar}<br />لذا تزين الزهرة الغامض دام في أيام و أيام<br />{/ar}<br />{ar}<br />لذا دام في أيام و أيام تزين الزهرة الغامض<br />{/ar}<br />{unl}<br />pos(100828704:99,     111669921:10.@def)<br />mod(100828704:99,     300939444:62)<br />aoj(202704928:90.@past.@anterior.@so.@entry,     100828704:99)<br />tim(202704928:90.@past.@anterior.@so.@entry,     115155220:32.@pl)<br />tim(202704928:90.@past.@anterior.@so.@entry,     115155220:54.@pl)<br />and(115155220:54.@pl,     115155220:32.@pl)<br />{/unl}<br />[/S]<br /><br />[S:376138]<br />{org:fr}<br />Et puis voici qu’un matin, justement à l’heure du lever du soleil, elle s’était montrée.<br />{/org}<br />{ar}<br />هو أظهر نفسه في صباح واحد من فجر بالتحديد بعد ذلك<br />{/ar}<br />{ar}<br />هو أظهر نفسه بعد ذلك في صباح 1 من فجر بالتحديد<br />{/ar}<br />{ar}<br />هي أظهرت نفسها في صباح واحد من فجر بالتحديد بعد ذلك<br />{/ar}<br />{ar}<br />هي أظهرت نفسها بعد ذلك في صباح 1 من فجر بالتحديد<br />{/ar}<br />{unl}<br />agt(202139544:18.@anterior.@past.@reflexive.@entry,     600000565:82.@3)<br />qua(115165289:20,     &quot;1&quot;:19.@numeral)<br />tim(202139544:18.@anterior.@past.@reflexive.@entry,     115165289:20)<br />scn(202139544:18.@anterior.@past.@reflexive.@entry,     115168790:83)<br />man(115168790:83,     400158309:51)<br />tim(202139544:18.@anterior.@past.@reflexive.@entry,     400117620:41)<br />{/unl}<br />[/S]<br /><br />[S:376139]<br />{org:fr}<br />Et elle, qui avait travaillé avec tant de précision, dit en bâillant:<br />{/org}<br />{ar}<br />الزهرة التي عملت بدقة كبيرة قالت ثئب<br />{/ar}<br />{ar}<br />قالت الزهرة التي عملت بدقة كبيرة ثئب<br />{/ar}<br />{unl}<br />agt(202413480:73.@past.@anterior.@relative,     111669921:38)<br />man(202413480:73.@past.@anterior.@relative,     104803880:12.@multal.@with)<br />man(201009240:26.@past.@entry,     200007328:98)<br />agt(201009240:26.@past.@entry,     111669921:38)<br />{/unl}<br />[/S]<br /><br />[S:376140]<br />{org:fr}<br />Je me réveille à peine (pds) .<br />{/org}<br />{ar}<br />أنا استيقظت بالكاد<br />{/ar}<br />{ar}<br />أنا بالكاد استيقظت<br />{/ar}<br />{ar}<br />استيقظت بالكاد<br />{/ar}<br />{ar}<br />بالكاد استيقظت<br />{/ar}<br />{unl}<br />agt(200018526:89.@present.@entry,     600000565:26.@1)<br />man(200018526:89.@present.@entry,     400002621:47)<br />{/unl}<br />[/S]<br /><br />[S:376142]<br />{org:fr}<br />Je suis encore toute décoiffée (pds) .<br />{/org}<br />{ar}<br />أنا مجعد تماما دون تغير<br />{/ar}<br />{ar}<br />أنا مجعد دون تغير تماما<br />{/ar}<br />{unl}<br />aoj(302425220:86.@present.@entry,     600000565:75.@1)<br />mod(302425220:86.@present.@entry,     400031304:55)<br />mod(302425220:86.@present.@entry,     400008007:13)<br />{/unl}<br />[/S]<br /><br />[S:376143]<br />{org:fr}<br />Le petit prince, alors, ne put contenir son admiration:<br />{/org}<br />{ar}<br />لذا أمير صغير لا يمكن أن تحكم في استغراب أمير صغير<br />{/ar}<br />{ar}<br />لذا أمير صغير لا يمكن أن تحكم في اندهاش أمير صغير<br />{/ar}<br />{unl}<br />agt(202510337:79.@ability.@past.@not.@entry.@so,     500324405:45)<br />obj(202510337:79.@ability.@past.@not.@entry.@so,     107509996:89)<br />pos(107509996:89,     500324405:45)<br />{/unl}<br />[/S]<br /><br />[S:376144]<br />{org:fr}<br />Que vous êtes belle!<br />{/org}<br />{ar}<br />يا للعجب أنت حسن<br />{/ar}<br />{unl}<br />aoj(300217728:54.@surprise.@entry,     600000565:49.@2.@polite)<br />{/unl}<br />[/S]<br /><br />[S:376145]<br />{org:fr}<br />N’est-ce pas, répondit doucement la fleur.<br />{/org}<br />{ar}<br />أجابت الزهرة بلطف أكدت<br />{/ar}<br />{ar}<br />الزهرة أجابت بلطف أكدت<br />{/ar}<br />{unl}<br />agt(200815686:26.@past.@entry,     111669921:93.@def)<br />man(200815686:26.@past.@entry,     400004394:49)<br />obj(200815686:26.@past.@entry,     600000565:37.@confirmation)<br />{/unl}<br />[/S]<br /><br />[S:376146]<br />{org:fr}<br />J’ai beaucoup vécu chez les grandes personnes.<br />{/org}<br />{ar}<br />أنا عشت وسط بالغ جدا<br />{/ar}<br />{ar}<br />سكنت بين بالغ جدا<br />{/ar}<br />{ar}<br />انا عشت جدا في وسط كاهل<br />{/ar}<br />{unl}<br />plc(202649830.@entry.@past.@plus,     109605289.@generic.@among)<br />aoj(202649830.@entry.@past.@plus,     600000565.@1)<br />{/unl}<br />[/S]<br /><br />[S:376147]<br />{org:fr}<br />Et je suis née en même temps que le soleil (pds) .<br />{/org}<br />{ar}<br />أنا ولدت بالتزامن مع الشمس<br />{/ar}<br />{ar}<br />ولدت في نفس الوقت مع الشمس<br />{/ar}<br />{unl}<br />obj(200056930:80.@hesitation.@passive.@entry,     600000565:17.@1)<br />man(200056930:80.@hesitation.@passive.@entry,     400120223:36)<br />bas(400120223:36,     109450163:46.@def)<br />tim(200056930:80.@hesitation.@passive.@entry,     109450163:46.@def)<br />and(200056930:80.@hesitation.@passive.@entry,     600000565:99)<br />{/unl}<br />[/S]<br /><br />[S:376148]<br />{org:fr}<br />Le petit prince devina bien qu’elle n’était pas trop modeste, mais elle était si émouvante!<br />{/org}<br />{ar}<br />أمير صغير خمن جيدا الزهرة ليست متواضعة جدا و لكن الزهرة مؤثرة للغاية<br />{/ar}<br />{ar}<br />خمن أمير صغير جيدا أن الزهرة ليست متواضعة جدا و لكن الزهرة مؤثرة للغاية<br />{/ar}<br />{unl}<br />agt(200636061:85.@past.@entry,     500324405:37)<br />man(200636061:85.@past.@entry,     400011093:88)<br />aoj(301539225:22.@past.@imperfective.@not,     111669921:68.@def)<br />obj(200636061:85.@past.@entry,     301539225:22.@past.@imperfective.@not)<br />mod(301539225:22.@past.@imperfective.@not,     400250258:65)<br />and(301560513:13.@past.@imperfective.@but.@contentment,     301539225:22.@past.@imperfective.@not)<br />aoj(301560513:13.@past.@imperfective.@but.@contentment,     111669921:68.@def)<br />mod(301560513:13.@past.@imperfective.@but.@contentment,     400146594:44)<br />{/unl}<br />[/S]<br /><br />[S:376149]<br />{org:fr}<br />C’est l’heure, je crois, du petit déjeuner, avait-elle bientôt ajouté, auriez-vous la bonté de penser à moi (pds) .<br />{/org}<br />{ar}<br />زهرة أضافت قريبا أن أفكر في وقت الفطور أنتم لديكم لطف فكر في أنا<br />{/ar}<br />{ar}<br />أضافت زهرة قريبا أن أفكر في وقت الفطور أنتم لديكم لطف فكر فيا<br />{/ar}<br />{unl}<br />aoj(115245515:31.@def.@topic.@present.@speech,     600000565:63)<br />aoj(200689344:37.@present.@speech,     600000565:49.@1)<br />mod(115245515:31.@def.@topic.@present.@speech,     107574602:77.@def)<br />agt(201027174:66.@past.@anterior.@entry,     111669921:24)<br />tim(201027174:66.@past.@anterior.@entry,     400033922:61)<br />aoj(202630189:34.@polite.@hesitation.@speech,     600000565:92.@2.@pl)<br />obj(202630189:34.@polite.@hesitation.@speech,     104840011:54.@def)<br />obj(200734348:43,     600000565:87.@1)<br />obj(200689344:37.@present.@speech,     115245515:31.@def.@topic.@present.@speech)<br />obj(201027174:66.@past.@anterior.@entry,     115245515:31.@def.@topic.@present.@speech)<br />mod(104840011:54.@def,     200734348:43)<br />obj(201027174:66.@past.@anterior.@entry,     202630189:34.@polite.@hesitation.@speech)<br />{/unl}<br />[/S]<br /><br />[S:376150]<br />{org:fr}<br />Et le petit prince, tout confus, ayant été chercher un arrosoir d’eau fraîche, avait servi la fleur.<br />{/org}<br />{ar}<br />و قدم الطعام لزهرة و أمير صغير حائر تماما بعد أن أمير صغير فحص رشاش ماء مع ماء عذب<br />{/ar}<br />{ar}<br />و قدم الطعام لزهرة و أمير صغير حائر تماما بعد أن فحص أمير صغير رشاش ماء مع ماء عذب<br />{/ar}<br />{unl}<br />mod(500324405:25,     300435492:23.@topic)<br />mod(300435492:23.@topic,     400008007:95)<br />agt(201315613:19.@perfective.@after,     500324405:25)<br />obj(201315613:19.@perfective.@after,     104560292:73.@indef)<br />mod(104560292:73.@indef,     115009326:37.@with)<br />obj(201181295:27.@past.@anterior.@entry,     500324405:25)<br />obj(201181295:27.@past.@anterior.@entry,     111669921:45.@def)<br />tim(201181295:27.@past.@anterior.@entry,     201315613:19.@perfective.@after)<br />and(201181295:27.@past.@anterior.@entry,     600000565:28)<br />{/unl}<br />[/S]<br /><br />[S:376151]<br />{org:fr}<br />Ainsi l’avait-elle bien vite tourmenté par sa vanité un peu ombrageuse.<br />{/org}<br />{ar}<br />لذلك هو أزعجه بسرعة إذا غروره عصبي بشكل هزيل<br />{/ar}<br />{ar}<br />لذلك هو أزعجها بسرعة إذا غرورها عصبي بشكل هزيل<br />{/ar}<br />{ar}<br />لذلك هي أزعجه بسرعة إذا غروره عصبي بشكل هزيل<br />{/ar}<br />{ar}<br />لذلك هي أزعجها بسرعة إذا غرورها عصبي بشكل هزيل<br />{/ar}<br />{ar}<br />لذلك هو بسرعة أزعجه إذا غروره عصبي بشكل هزيل<br />{/ar}<br />{unl}<br />man(201802689:47.@anterior.@past.@entry,     400043003:94)<br />agt(201802689:47.@anterior.@past.@entry,     600000565:64.@3)<br />obj(201802689:47.@anterior.@past.@entry,     600000565:54.@3.@topic)<br />man(400085811:14,     400018781:71)<br />man(201802689:47.@anterior.@past.@entry,     400085811:14)<br />mod(301136541:56,     400458270:67)<br />mod(107508996:77,     301136541:56)<br />con(201802689:47.@anterior.@past.@entry,     107508996:77)<br />pos(107508996:77,     600000565:64.@3)<br />{/unl}<br />[/S]<br /><br />[S:376152]<br />{org:fr}<br />Un jour, par exemple, parlant de ses quatre épines, elle avait dit au petit prince:<br />{/org}<br />{ar}<br />وردة قالت لأمير صغير ذات مرة على سبيل المثال أثناء تحدث وردة عن 4 أشواك<br />{/ar}<br />{ar}<br />قالت وردة لأمير صغير على سبيل المثال ذات مرة أثناء تحدث وردة عن أربع أشواك<br />{/ar}<br />{unl}<br />cnt(200962447:35,     113089631:34.@pl)<br />qua(113089631:34.@pl,     &quot;4&quot;:38)<br />agt(201009240:21.@past.@anterior.@entry,     112620196:90)<br />gol(201009240:21.@past.@anterior.@entry,     500324405:13)<br />tim(201009240:21.@past.@anterior.@entry,     400118869:10)<br />man(201009240:21.@past.@anterior.@entry,     400159040:26)<br />agt(200962447:35,     112620196:90)<br />coo(201009240:21.@past.@anterior.@entry,     200962447:35)<br />pos(113089631:34.@pl,     112620196:90)<br />{/unl}<br />[/S]<br /><br />[S:376153]<br />{org:fr}<br />Ils peuvent venir, les tigres, avec leurs griffes!<br />{/org}<br />{ar}<br />يمكن أن تصل النمور ذات المخالب!<br />{/ar}<br />{ar}<br />يمكن أن تصل النمور مع المخالب!<br />{/ar}<br />{ar}<br />يمكن النمور ذات المخالب أن تصل!<br />{/ar}<br />{unl}<br />agt(202005948:88.@possibility.@present.@entry.@exclamation,     102129604:90.@pl.@def.@emphasis)<br />mod(102129604:90.@pl.@def.@emphasis,     102156140:70.@pl.@with)<br />{/unl}<br />[/S]<br /><br />[S:376154]<br />{org:fr}<br />Il n’y a pas de tigres sur ma planète, avait objecté le petit prince, et puis les tigres ne mangent pas d’herbe.<br />{/org}<br />{ar}<br />أمير صغير اعترض على أن النمور لم تأكل عشب و لم تخرج النمور من كوكبي<br />{/ar}<br />{ar}<br />اعترض أمير صغير على أن النمور لم تأكل عشب و لم تخرج النمور من كوكبي<br />{/ar}<br />{unl}<br />aoj(202603699:45.@not.@present.@speech,     102129604:67.@pl.@generic)<br />plc(202603699:45.@not.@present.@speech,     109394646:84)<br />agt(200807461:56.@past.@anterior.@entry,     500324405:23)<br />agt(201168468:80.@not.@speech,     102129604:67.@pl.@generic)<br />and(201168468:80.@not.@speech,     202603699:45.@not.@present.@speech)<br />obj(200807461:56.@past.@anterior.@entry,     201168468:80.@not.@speech)<br />obj(201168468:80.@not.@speech,     112102133:79.@generic)<br />pos(109394646:84,     600000565:69.@1)<br />{/unl}<br />[/S]<br /><br />[S:376155]<br />{org:fr}<br />Je ne suis pas une herbe, avait doucement répondu la fleur.<br />{/org}<br />{ar}<br />الزهرة أجابت بلطف على لا عشبي<br />{/ar}<br />{ar}<br />أجابت الزهرة بلطف على لا عشبي<br />{/ar}<br />{ar}<br />الزهرة بلطف أجابت على لا عشبي<br />{/ar}<br />{unl}<br />aoj(112102133:46.@indef.@not.@present.@speech,     600000565:72.@1)<br />agt(200815686:43.@past.@anterior.@entry,     111669921:14.@def)<br />man(200815686:43.@past.@anterior.@entry,     400502847:74)<br />obj(200815686:43.@past.@anterior.@entry,     112102133:46.@indef.@not.@present.@speech)<br />{/unl}<br />[/S]<br /><br />[S:376156]<br />{org:fr}<br />Pardonnez-moi (pds) .<br />{/org}<br />{ar}<br />بتردد أغذرني<br />{/ar}<br />{ar}<br />أغذرني بتردد<br />{/ar}<br />{unl}<br />obj(200905852:54.@hesitation.@imperative.@entry,     600000565:50.@1)<br />{/unl}<br />[/S]<br /><br />[S:376157]<br />{org:fr}<br />Je les ai vues de très près.<br />{/org}<br />{ar}<br />رأيت بالغ عن قرب جدا<br />{/ar}<br />{ar}<br />أنا رأيت كاهل عن قرب جدا<br />{/ar}<br />{unl}<br />man(202129289.@entry.@past,     400160440.@plus)<br />obj(202129289.@entry.@past,     109605289.@generic)<br />agt(202129289.@entry.@past,     600000565.@1)<br />{/unl}<br />[/S]<br /><br />[S:376158]<br />{org:fr}<br />Je ne crains rien des tigres, mais j’ai horreur des courants d’air.<br />{/org}<br />{ar}<br />لكني خفت من ريح و أخاف لا شيء نمر<br />{/ar}<br />{unl}<br />aoj(201780202:20.@present,     600000565:95.@1)<br />and(201780202:12.@present.@but.@entry,     201780202:20.@present)<br />obj(201780202:12.@present.@but.@entry,     111525955:43.@generic)<br />aoj(201780202:12.@present.@but.@entry,     600000565:95.@1)<br />obj(201780202:20.@present,     600000565:72.@not.@thing)<br />mod(600000565:72.@not.@thing,     102129604:17.@generic)<br />{/unl}<br />[/S]<br /><br />[S:376159]<br />{org:fr}<br />Vous n’auriez pas un paravent?<br />{/org}<br />{ar}<br />أنت لديك حاجز<br />{/ar}<br />{ar}<br />لديك حاجز<br />{/ar}<br />{unl}<br />aoj(202203362:68.@polite.@interrogative.@entry,     600000565:93.@2.@polite)<br />obj(202203362:68.@polite.@interrogative.@entry,     104152387:99.@indef)<br />{/unl}<br />[/S]<br /><br />[S:376160]<br />{org:fr}<br />Horreur des courants d’air (pds) .<br />{/org}<br />{ar}<br />بتردد رعب تيار<br />{/ar}<br />{ar}<br />بتردد رعب تيار هوائي<br />{/ar}<br />{unl}<br />obj(600000565:62.@ellipsis.@hesitation,     107520411:46.@entry)<br />mod(107520411:46.@entry,     111522448:91)<br />{/unl}<br />[/S]<br /><br />[S:376161]<br />{org:fr}<br />ce n’est pas de chance, pour une plante, avait remarqué le petit prince.<br />{/org}<br />{ar}<br />أمير صغير لاحظ لا نصيب لكوكب<br />{/ar}<br />{ar}<br />لاحظ أمير صغير لا قدر لكوكب<br />{/ar}<br />{unl}<br />aoj(111418460:37.@not.@speech,     600000565:74)<br />ben(111418460:37.@not.@speech,     100017222:70.@indef)<br />obj(202118476:54.@past.@anterior.@entry,     111418460:37.@not.@speech)<br />agt(202118476:54.@past.@anterior.@entry,     500324405:73)<br />{/unl}<br />[/S]<br /><br />[S:376162]<br />{org:fr}<br />Cette fleur est bien compliquée (pds) .<br />{/org}<br />{ar}<br />هذه الزهرة معقدة<br />{/ar}<br />{unl}<br />aoj(302177584:16.@entry,     111669921:51.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:376163]<br />{org:fr}<br />Le soir vous me mettrez sous un globe.<br />{/org}<br />{ar}<br />أنت سوف تضعني ليلا تحت كرة<br />{/ar}<br />{ar}<br />ستضعني تحت كرة ليلا<br />{/ar}<br />{unl}<br />agt(201494310:16.@future.@entry,     600000565:34.@2.@formal)<br />obj(201494310:16.@future.@entry,     600000565:54.@1)<br />tim(201494310:16.@future.@entry,     115167027:31)<br />plc(201494310:16.@future.@entry,     113899404:69.@under.@indef)<br />{/unl}<br />[/S]<br /><br />[S:376164]<br />{org:fr}<br />Il fait très froid chez vous.<br />{/org}<br />{ar}<br />تسبب في بارد جدا في مكانك<br />{/ar}<br />{unl}<br />obj(201645601:85.@entry,     301251128:58)<br />mod(301251128:58,     400031899:95)<br />pos(108559508:10.@ellipsis,     600000565:92.@2)<br />plc(301251128:58,     108559508:10.@ellipsis)<br />{/unl}<br />[/S]<br /><br />[S:376165]<br />{org:fr}<br />C’est mal installé.<br />{/org}<br />{ar}<br />ركب بشكل سيئ<br />{/ar}<br />{ar}<br />ركب على نحو ضعيف<br />{/ar}<br />{ar}<br />ركب بشكل رديء<br />{/ar}<br />{unl}<br />aoj(201569566:77.@present.@entry,     600000565:91)<br />man(201569566:77.@present.@entry,     400011516:58)<br />{/unl}<br />[/S]<br /><br />[S:376166]<br />{org:fr}<br />Là d’où je viens (pds) .<br />{/org}<br />{ar}<br />أنا الذي أنشأ في ذلك<br />{/ar}<br />{unl}<br />agt(202627666:98.@present.@relative.@entry,     600000565:57.@1)<br />plc(202627666:98.@present.@relative.@entry,     600000565:26.@distal.@topic)<br />{/unl}<br />[/S]<br /><br />[S:376167]<br />{org:fr}<br />Mais elle s’était interrompue.<br />{/org}<br />{ar}<br />و لكن زهرة أوقفت نفسها<br />{/ar}<br />{ar}<br />و لكن أوقفت زهرة نفسها<br />{/ar}<br />{unl}<br />agt(200362348:98.@reflexive.@past.@anterior.@but.@entry,     111669921:97)<br />and(200362348:98.@reflexive.@past.@anterior.@but.@entry,     600000565:93)<br />{/unl}<br />[/S]<br /><br />[S:376168]<br />{org:fr}<br />Ça n’a pas trop amélioré mon opinion.<br />{/org}<br />{ar}<br />رأى لم يرتقى برأيي<br />{/ar}<br />{ar}<br />رأى رأيي لم يصلح <br />{/ar}<br />{unl}<br />obj(200205885.@entry.@not.@past,     105945642.@def)<br />pos(105945642.@def,     600000565.@1)<br />aoj(200205885.@entry.@not.@past,     202129289)<br />{/unl}<br />[/S]<br /><br />[S:376169]<br />{org:fr}<br />Elle était venue sous forme de graine.<br />{/org}<br />{ar}<br />الزهرة وصلت بشكل بذرة<br />{/ar}<br />{ar}<br />وصلت الزهرة بشكل بذرة<br />{/ar}<br />{unl}<br />aoj(202005948:43.@past.@anterior.@entry,     111669921:62.@def)<br />man(202005948:43.@past.@anterior.@entry,     105930736:71.@def)<br />mod(105930736:71.@def,     113135832:47.@indef)<br />{/unl}<br />[/S]<br /><br />[S:376170]<br />{org:fr}<br />Elle n’avait rien pu connaître des autres mondes.<br />{/org}<br />{ar}<br />يمكن الزهرة أن تعرف لا شيء عن عوالم أخرى<br />{/ar}<br />{ar}<br />الزهرة يمكن أن تعرف لا شيء عوالم أخرى<br />