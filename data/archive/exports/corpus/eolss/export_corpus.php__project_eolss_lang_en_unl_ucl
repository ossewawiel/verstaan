72:0I)<br />pur(201158572:0I,     115689206:0Q)<br />qua(102801525:14.@topic,     &quot;1&quot;:10)<br />man(302335828:1L.@entry,     400535718:1D)<br />aoj(302335828:1L.@entry,     102801525:14.@topic)<br />obj(201158572:0I,     115689732:05)<br />{/unl}<br />[/S]<br /><br />[S:1038]<br />{org:en}<br />If stream water is used, it is better to use a series of basins (Figures 1-3).<br />{/org}<br />{unl}<br />con(300523364:0X.@entry,     201158572:0L)<br />obj(201158572:0L,     107935504:0C)<br />obj(201158572:17,     102801525:1N.@pl)<br />con(300523364:0X.@entry,     201158572:0L)<br />obj(201158572:0L,     107935504:0C)<br />obj(201158572:17,     102801525:1N.@pl)<br />man(300523364:0X.@entry,     400099341:28)<br />aoj(300523364:0X.@entry,     201158572:17)<br />mod(107935504:0C,     107406765:05)<br />mod(102801525:1N.@pl,     600000577:1B)<br />[W]<br />:01.@entry.@parenthesis<br />[/W]<br />{/unl}<br />[/S]<br /><br />[S:1039]<br />{org:en}<br />In this case water is taken from the river by a single channel where it arrives at the first basin, and then slowly flows into the others.<br />{/org}<br />{unl}<br />man(200523095:0O.@entry,     600000186:02)<br />man:01(400161630:33,     400117620:2Y)<br />mod(103006105:1L.@indef,     300539389:1E)<br />src(200523095:0O.@entry,     109411430:13.@def)<br />man(200523095:0O.@entry,     600000186:02)<br />man:01(400161630:33,     400117620:2Y)<br />mod(103006105:1L.@indef,     300539389:1E)<br />src(200523095:0O.@entry,     109411430:13.@def)<br />gol:01(200217427:3A.@entry,     600000063:3P.@def)<br />agt(200523095:0O.@entry,     103006105:1L.@indef)<br />mod:01(102801525:2N,     &quot;1&quot;:2H)<br />and:01(200217427:3A.@entry,     202005948:22)<br />obj(200523095:0O.@entry,     107935504:0F.@topic)<br />gol:01(202005948:22,     102801525:2N)<br />gol:01(202005948:22,     102801525:2N)<br />obj(:01,     600000016:1Z)<br />plc(:01,     103006105:1L.@indef)<br />man:01(200217427:3A.@entry,     400161630:33)<br />{/unl}