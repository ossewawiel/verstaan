:02)<br />mod(100947128:1S.@pl,     107935504:20)<br />gol(200114837:15,     100947128:2M.@pl)<br />mod(100947128:1S.@pl,     107935504:20)<br />gol(200114837:15,     100947128:2M.@pl)<br />agt(200114837:15,     101023242:0M.@topic.@pl)<br />aoj(301870889:2B,     100947128:2M.@pl)<br />obj(202000868:31.@entry.@should.@past,     101023242:0M.@topic.@pl)<br />aoj(301870889:1H.@not,     100947128:1S.@pl)<br />aoj(301870889:1H.@not,     100947128:1S.@pl)<br />obj(200114837:15,     100947128:1S.@pl)<br />{/unl}<br />[/S]<br /><br />[S:5028]<br />{org:en}<br />But these gains may not yield tremendous amounts of water to slow the need for growth in irrigation development.<br />{/org}<br />{unl}<br />agt(200804476:0Q.@entry.@may.@not,     113254805:0C.@pl)<br />obj(200440580:1R,     109367991:20.@def)<br />qua(107935504:1I,     100033615:17.@pl)<br />mod(100250259:2U,     100695448:2J)<br />obj(200440580:1R,     109367991:20.@def)<br />qua(107935504:1I,     100033615:17.@pl)<br />mod(100250259:2U,     100695448:2J)<br />pur(107935504:1I,     200440580:1R)<br />scn(108438067:29,     100250259:2U)<br />obj(200804476:0Q.@entry.@may.@not,     107935504:1I)<br />obj(109367991:20.@def,     108438067:29)<br />obj(109367991:20.@def,     108438067:29)<br />aoj(303161779:0W,     100033615:17.@pl)<br />mod(113254805:0C.@pl,     600000017:06)<br />{/unl}<br />[/S]<br /><br />[S:5029]<br />{org:en}<br />The real place to find savings is in increasing the productivity of water consumed in agriculture, as discussed in the above section.<br />{/org}<br />{unl}<br />aoj(200153263:13.@entry.@progress,     100721431:0B.@topic.@def)<br />aoj(300013662:06,     100721431:0B.@topic.@def)<br />scn(200600903:24.@past,     108075287:2G)<br />obj(200600903:24.@past,     107935504:1Y)<br />mod(104164989:3J.@def,     300125993:3D)<br />aoj(300013662:06,     100721431:0B.@topic.@def)<br />scn(200600903:24.@past,     108075287:2G)<br />obj(200600903:24.@past,     107935504:1Y)<br />mod(104164989:3J.@def,     300125993:3D)<br />mod(113824500:1I.@def,     107935504:1Y)<br />plc(202774210:2W.@past,     104164989:3J.@def)<br />obj(200153263:13.@entry.@progress,     113824500:1I.@def)<br />obj(200715239:0K,     100192613:0P.@pl)<br />obj(600000008:2T,     202774210:2W.@past)<br />obj(200715239:0K,     100192613:0P.@pl)<br />obj(600000008:2T,     202774210:2W.@past)<br />man(200600903:24.@past,     600000008:2T)<br />pur(100721431:0B.@topic.@def,     200715239:0K)<br />{/unl}<br />[/S]<br /><br />[S:5030]<br />{org:en}<br />Rain-Fed versus Irrigated Agriculture<br />{/org}<br />{unl}<br />obj(200189511:0A.@past,     108075287:0Z.@entry)<br />obj(202775812:0E,     200079951:0L)<br />obj(202775812:0E,     200079951:0L)<br />agt(200189511:0A.@past,     105045208:05)<br />man(200189511:0A.@past,     202775812:0E)<br />{/unl}<br />[/S]<br /><br />[S:5031]<br />{org:en}<br />One popular idea is to concentrate food production in rain-fed, rather than irrigated, areas to avoid adverse consequences of water infrastructure development.<br />{/org}<br />{unl}<br />plc(200237511:0P.@entry.@will,     102735688:2O.@pl)<br />obj(600000151:1X,     200079951:29)<br />qua(105833840:0E.@topic,     &quot;1&quot;:02)<br />mod(100250259:4C,     103569964:3X)<br />obj(200237511:0P.@entry.@will,     100522736:16)<br />aoj(300995647:33,     105170574:3B.@pl)<br />man(200189511:1S.@past,     600000151:1X)<br />obj(600000151:1X,     200079951:29)<br />qua(105833840:0E.@topic,     &quot;1&quot;:02)<br />mod(100250259:4C,     103569964:3X)<br />obj(200237511:0P.@entry.@will,     100522736:16)<br />aoj(300995647:33,     105170574:3B.@pl)<br />man(200189511:1S.@past,     600000151:1X)<br />agt(200237511:0P.@entry.@will,     105833840:0E.@topic)<br />mod(105170574:3B.@pl,     100250259:4C)<br />obj(200189511:1S.@past,     102735688:2O.@pl)<br />pur(200237511:0P.@entry.@will,     200811375:2X)<br />obj(200811375:2X,     105170574:3B.@pl)<br />aoj(300414518:06,     105833840:0E.@topic)<br />obj(200811375:2X,     105170574:3B.@pl)<br />aoj(300414518:06,     105833840:0E.@topic)<br />mod(100522736:16,     100021265:11)<br />mod(100250259:4C,     107935504:3R)<br />agt(200189511:1S.@past,     105045208:1N)<br />{/unl}<br />[/S]<br /><br />[S:5032]<br />{org:en}<br />At present more than three-quarters of the world's cultivated area is rain-fed, producing some 60% of the world's total grain production.<br />{/org}<br />{unl}<br />agt(201621555:2H.@entry.@progress,     101258579:0T.@topic.@pl)<br />qua(101258579:0T.@topic.@pl,     400099341:0D)<br />mod(100522736:3R.@def,     105670972:37)<br />qua(100522736:3R.@def,     &quot;60%&quot;:2W)<br />aoj(301833643:1H,     102735688:1S.@def)<br />agt(200189511:28.@past,     105045208:23)<br />qua(101258579:0T.@topic.@pl,     400099341:0D)<br />mod(100522736:3R.@def,     105670972:37)<br />qua(100522736:3R.@def,     &quot;60%&quot;:2W)<br />aoj(301833643:1H,     102735688:1S.@def)<br />agt(200189511:28.@past,     105045208:23)<br />obj(201621555:2H.@entry.@progress,     &quot;60%&quot;:2W)<br />mod(102735688:1S.@def,     105670972:19)<br />mod(100522736:3R.@def,     104950713:3L)<br />obj(200189511:28.@past,     201621555:2H.@entry.@progress)<br />bas(400099341:0D,     &quot;3&quot;:0N)<br />qua(100522736:3R.@def,     303160907:3F)<br />bas(400099341:0D,     &quot;3&quot;:0N)<br />qua(100522736:3R.@def,     303160907:3F)<br />qua(&quot;60%&quot;:2W,     600000034:2R)<br />mod(101258579:0T.@topic.@pl,     102735688:1S.@def)<br />{/unl}<br />[/S]<br /><br />[S:5033]<br />{org:en}<br />Because of its larger scale, productivity improvements in rain-fed agriculture will have a much larger impact on total production than in irrigated agriculture.<br />{/org}<br />{unl}<br />man(200065370:2E.@entry.@will,     600000012:02)<br />obj(200079951:3W.@past,     108075287:46)<br />aoj(300527870:2Q,     107338552:2X.@indef)<br />obj(600000012:02,     101902877:0O)<br />obj(200065370:2E.@entry.@will,     107338552:2X.@indef)<br />obj(20018951