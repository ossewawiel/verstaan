82144:33,     106286395:79.@proximal.@pl)<br />{/unl}<br />[/S]<br /><br />[S:407356]<br />{org:fr}<br />ils s'excluent mutuellement.<br />{/org}<br />{unl}<br />aoj(202633714:53.@reciprocal,     600000565:84.@3.@pl)<br />man(202633714:53.@reciprocal,     400405645:56)<br />{/unl}<br />[/S]<br /><br />[S:407359]<br />{org:fr}<br />Chapitre 1.5<br />{/org}<br />{unl}<br />mod(106396142:53,     &quot;1&quot;:01.5:88)<br />{/unl}<br />[/S]<br /><br />[S:407360]<br />{org:fr}<br />Qu'il faut toujours remonter à une première convention<br />{/org}<br />{unl}<br />mod(105667613:68.@indef,     &quot;1&quot;:82.@ordinal)<br />lpl(200959714:61.@obligation.@continuative.@relative,     105667613:68.@indef)<br />{/unl}<br />[/S]<br /><br />[S:407365]<br />{org:fr}<br />il n'y a là ni bien public, ni corps politique.<br />{/org}<br />{unl}<br />obj(202603699:35.@not,     115669187:19)<br />mod(107965085:97.@neither,     301814385:51)<br />obj(202603699:35.@not,     107965085:97.@neither)<br />or (107965085:97.@neither,     115669187:19)<br />lpl(202603699:35.@not,     600000565:42)<br />{/unl}<br />[/S]<br /><br />[S:407369]<br />{org:fr}<br />Un peuple, dit Grotius, peut se donner à un roi.<br />{/org}<br />{unl}<br />agt(201009240:24,     111017454:58)<br />obj(201009240:24,     :01)<br />agt:01(107942152:48.@generic,     202316868:75.@possibility.@reflexive)<br />gol:01(202316868:75.@possibility.@reflexive,     110231515:78.@generique)<br />{/unl}<br />[/S]<br /><br />[S:407372]<br />{org:fr}<br />il suppose une délibération publique.<br />{/org}<br />{unl}<br />aoj(200716345:85,     600000565:61.@3)<br />mod(107142365:54,     300493297:77)<br />obj(200716345:85,     107142365:54)<br />{/unl}<br />[/S]<br /><br />[S:407378]<br />{org:fr}<br />Chapitre 1.6<br />{/org}<br />{unl}<br />mod(106396142:82,     &quot;1&quot;:01.6:43)<br />{/unl}<br />[/S]<br /><br />[S:407379]<br />{org:fr}<br />Du pacte social<br />{/org}<br />{unl}<br />mod(106520944:28,     302798370:95)<br />mod(106520944:28,     600000565:86)<br />{/unl}<br />[/S]<br /><br />[S:407381]<br />{org:fr}<br />Alors cet état primitif ne peut plus subsister;<br />{/org}<br />{unl}<br />mod(100024720:45.@proximal,     300817731:83)<br />aoj(202616713:60.@not.@possibility,     100024720:45.@proximal)<br />{/unl}<br />[/S]<br /><br />[S:407382]<br />{org:fr}<br />et le genre humain périrait s'il ne changeait de manière d'être.<br />{/org}<br />{unl}<br />mod(108110648:73,     301258617:49)<br />exp(200358431:46.@past.@posterior,     108110648:73)<br />and(200358431:46.@past.@posterior,     600000565:97)<br />con(200358431:46.@past.@posterior,     :01)<br />exp:01(200126264:87.@past.@not,     108110648:39)<br />mod:01(108110648:39,     301258617:28)<br />obj:01(200126264:87.@past.@not,     104928903:21)<br />mod:01(104928903:21,     202603699:82)<br />{/unl}<br />[/S]<br /><br />[S:407384]<br />{org:fr}<br />Cette somme de forces ne peut naître que du concours de plusieurs;<br />{/org}<br />{unl}<br />aoj(200339738:57.@only.@possibility,     :01)<br />obj:01(105861067:83.@proximal,     105194578:77.@pl)<br />lpl(:01,     concours:56)<br />mod(concours:56,     100007846:96.@multal)<br />{/unl}<br />[/S]<br /><br />[S:407397]<br />{org:fr}<br />Enfin, chacun se donnant à tous ne se donne à personne;<br />{/org}<br />{unl}<br />agt(202316868:10.@reflexive.@conclusion,     600000565:49.@each.@person)<br />obj(202316868:10.@reflexive.@conclusion,     115582940:94.@every.@person)<br />con(202316868:10.@reflexive.@conclusion,     :01)<br />agt:01(202316868:93.@reflexive.@not,     600000565:99.@each.@person)<br />obj:01(202316868:93.@reflexive.@not,     600000565:42.@not.@person)<br />{/unl}<br />[/S]<br /><br />[S:407407]<br />{org:fr}<br />Chapitre 1.7<br />{/org}<br />{unl}<br />mod(106396142:80,     &quot;1&quot;:01.7:20)<br />{/unl}<br />[/S]<br /><br />[S:407408]<br />{org:fr}<br />Du souverain<br />{/org}<br />{unl}<br />mod(110628644:56,     600000565:87)<br />{/unl}<br />[/S]<br /><br />[S:407420]<br />{org:fr}<br />et qui n'est rien ne produit rien.<br />{/org}<br />{unl}<br />obj(201621555:42,     600000565:72.@not.@thing)<br />and(201621555:42,     600000565:67)<br />agt(201621555:42,     :01)<br />aoj:01(600000565:77.@not.@thing.@relative,     600000565:93.@wh)<br />{/unl}<br />[/S]<br /><br />[S:407436]<br />{org:fr}<br />Chapitre 1.8<br />{/org}<br />{unl}<br />mod(106396142:77,     &quot;1&quot;:01.8:43)<br />{/unl}<br />[/S]<br /><br />[S:407437]<br />{org:fr}<br />De l'état civil<br />{/org}<br />{unl}<br />mod(100024720:95.@generique,     301518161:30)<br />mod(100024720:95.@generique,     600000565:25)<br />{/unl}<br />[/S]<br /><br />[S:407441]<br />{org:fr}<br />Réduisons toute cette balance à des termes faciles à comparer;<br />{/org}<br />{unl}<br />obj(200243900:19,     114002279:30.@proximal.@all)<br />gol(200243900:19,     106303888:69.@generique)<br />mod(106303888:69.@generique,     300749230:34)<br />man(300749230:34,     200652900:93)<br />{/unl}<br />[/S]<br /><br />[S:407449]<br />{org:fr}<br />Chapitre 1.9<br />{/org}<br />{unl}<br />mod(106396142:36,     &quot;1&quot;:01.9:99)<br />{/unl}<br />[/S]<br /><br />[S:407450]<br />{org:fr}<br />Du domaine réel<br />{/org}<br />{unl}<br />mod(domaine:28,     100540211:38)<br />{/unl}<br />[/S]<br /><br />[S:407465]<br />{org:fr}<br />Peut-on ne pas donner des bornes à ce droit?<br />{/org}<br />{unl}<br />obj(200233335:20.@not.@possibility.@interrogation,     105174653:74.@proximal)<br />agt(200233335:20.@not.@possibility.@interrogation,     600000565:11.@3.@person.@pl)<br />{/unl}<br />[/S]<br /><br />[/D]</body>
