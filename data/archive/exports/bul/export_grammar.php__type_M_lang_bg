MCL&DEF&PST&SNG&STR:="яп">"епи","ям">"еми","ял">"ели","ян">"ени","як">"еки","яв">"еви",0>"ят";<br />
MCL&DEF&CMP&SNG&SHO:="по-"<0,"яп">"епи","ям">"еми","ял">"ели","ян">"ени","як">"еки","яв">"еви",0>"я";<br />
