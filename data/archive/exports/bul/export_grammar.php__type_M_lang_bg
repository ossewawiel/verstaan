VOC:=0>"e";<br />
;<br /><br /><b>M17</b><br />същ. м.р. тип 1а (имат бройна и звателна форма); слона, слонът, слонове, слоновете, слона, слоне; (<i>кмет; кум; сфинкс, шеф; спец; лорд; лос;</i>)<br />SNG:=0>"";<br />
PLR:=0>"ове";<br />
