MCL&PST&DEF&SNG&SHO:="ъв">"ви","ър">"ри","ък">"ки","ъл">"ли","ъг">"ги",0>"я";<br />
MCL&DEF&CMP&SNG&SHO:="по-"<0,"ъв">"ви","ър">"ри","ък">"ки","ъл">"ли","ъг">"ги",0>"я";<br />
