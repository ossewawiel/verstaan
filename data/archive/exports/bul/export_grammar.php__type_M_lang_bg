;<br /><br /><b>M19</b><br />същ. м.р. тип 20; беглеца, беглецът, бегълци, бегълците, беглецо; (<i>беглец</i>)<br />SNG:=0>"";<br />
PLR:=3>"ълци";<br />
VOC:=0>"o";<br />
