MCL&DEF&CMP&SNG&STR:="по-"<0,"ъв">"ви","ър">"ри","ък">"ки","ъл">"ли","ъг">"ги",0>"ят";<br />
MCL&DEF&SUP&SNG&STR:="най-"<0,"ъв">"ви","ър">"ри","ък">"ки","ъл">"ли","ъг">"ги",0>"ят";<br />

FEM&SNG:="ъв">"ва","ър">"ра","ък">"ка","ъл">"ла","ъг">"га";<br />
