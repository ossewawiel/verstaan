<h1>Spanish Subcategorization  Grammar</h1>Version of September 11, 2026, 2:15 pm<br />Documentation available at <a href="http://www.unlarchive.org/wiki/index.php/Grammar" target="_blank">http://www.unlarchive.org/wiki/index.php/Grammar</a><br />Tagset available at <a href="../dictionary/export_tagset.php" target="_blank">Export UNDL Foundation tagset</a>.<br /><br /><b>Y0</b><br />AVALENT<br /><br /><b>Y1</b><br />NO SUBCATEGORIZATION FRAME: rules defined inside the entry in the dictionary<br /><br /><b>Y66</b><br />verb + CP (que) (<i>tener que</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(CP([que]));<br /><br /><b>Y67</b><br />Ditransitive (como) (<i>considerar algo como </i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([como]));<br /><br /><b>Y68</b><br />pronominal + (de) (<i>ocuparse de</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PPR,ACC,RPER,RNUM,RGEN),VC(PP([de],DAT));<br /><br /><b>Y69</b><br />pronominal + (de) + (a) (<i>extenderse de X a Y</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PPR,ACC,RPER,RNUM,RGEN),VC(PP([de],DAT)),VC(PP([a],DAT));<br /><br /><b>Y72</b><br />Adjetivos cuyo complement es introducido por "con" (<i>casado, relacionado</i>)<br />JC(PH([con]));<br /><br /><b>Y73</b><br />pronominal + (con) (<i>relacionarse con</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PPR,ACC,RPER,RNUM,RGEN),VC(PP([con],DAT));<br /><br /><b>Y74</b><br />pronominal + (en) (<i>dividirse en</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PPR,ACC,RPER,RNUM,RGEN),VC(PP([en],DAT));<br /><br /><b>Y75</b><br />pronominal + (a) (<i>referirse a</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PPR,ACC,RPER,RNUM,RGEN),VC(PP([a],DAT));<br /><br /><b>Y76</b><br />Indirect Transitive (con) (<i>comparar con</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([con],DAT));<br /><br /><b>Y77</b><br />prep + PP (en) (<i>con base en</i>)<br />PC(PP([en]));<br /><br /><b>Y78</b><br />prep + PP  (con) (<i>de acuerdo con</i>)<br />PC(PP([con]));<br /><br /><b>Y86</b><br />Direct Transitive + NP (<i>componer</i>)<br />VS(NP,NOM,APER,ANUM,AGEN),VC(NP,ACC);<br /><br /><b>Y87</b><br />Indirect Transitive (de) (<i>abusar de</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([de],DAT));<br /><br /><b>Y88</b><br />Intransitive (<i>morir</i>)<br />VS(NP,NOM,ANUM,APER);<br /><br /><b>Y90</b><br />copula (<i>ser, estar</i>)<br />VS(NP),VC(NP);<br /><br /><b>Y91</b><br />prep  + VP (<i>para salir</i>)<br />PP(VP);<br /><br /><b>Y94</b><br />Direct Transitive+ VP (<i>poder</i>)<br />VS(NP,NOM,ANUM,APER),VC(VP);<br /><br /><b>Y95</b><br />Indirect Transitive (en) (<i>creer</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([en],DAT));<br /><br /><b>Y96</b><br />Ditransitive (en) (<i>poner</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([en],DAT));<br /><br /><b>Y97</b><br />Ditransitive (con) (<i>relacionar</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([con],DAT));<br /><br /><b>Y98</b><br />Ditransitive (a) (<i>decir</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([a],DAT));<br /><br /><b>Y99</b><br />Indirect Transitive (por) (<i>eforzarse por</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([por],DAT));<br /><br /><b>Y100</b><br />Ditransitive (por) (<i>procesar por</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([por],DAT));<br /><br /><b>Y101</b><br />Indirect Transitive (a) (<i>afiliarse a</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([a],DAT));<br /><br /><b>Y102</b><br />Indirect Transitive (hacia) (<i>volverse hacia</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(PP([hacia],DAT));<br /><br /><b>Y104</b><br />prep + PP  (de) (<i>más allá de</i>)<br />PC(PP([de]));<br /><br /><b>Y105</b><br />adv + PP (de) (<i>antes de</i>)<br />AC(PP([de]));<br /><br /><b>Y106</b><br />prep + PP (a) (<i>debido a</i>)<br />PC(PP([a]));<br /><br /><b>Y107</b><br />Ditransitive (de) (<i>sacar algo de</i>)<br />VS(NP,NOM,ANUM,APER,AGEN),VC(NP,ACC),VC(PP([en],DAT));<br /><br /><b>Y139</b><br />if VS=NP, then NP, NOM, APER, AGEN, ANUM (<i>[ellas] son guapas.</i>)<br />VS(NP):=VS(NP,NOM,APER,ANUM,AGEN);<br /><br /><b>Y154</b><br />if VC= JP, then JP, ACC, RNUM, RGEN (<i>Ellas son [guapas].</i>)<br />VC(JP):=VC(JP,NOM,RNUM,RGEN);<br /><br /><b>Y155</b><br />if VC=NP, then NP, RNUM (<i>ellas son [mujeres] guapas.</i>)<br />VC(NP):=VC(NP,ACC,RNUM);<br /><br /><b>Y156</b><br />if VC=PP, then PP, DAT (<i>ella deu un libro [a John].</i>)<br />VC(PP):=VC(PP,DAT);<br /><br /><b>Y157</b><br />if NA=JP, then JP,RNUM,RGEN (<i>mujeres [guapas].</i>)<br />NA(JP):=NA(JP,RNUM,RGEN);<br /><br /><b>Y171</b><br />if IC=COP+PTP, then COP, RNUM,RPER (<i>ella [fué] quebrada.</i>)<br />IC(VER,VP(PTP):=IC(VER,RNUM,RPER);<br /><br /><b>Y210</b><br />verbo pronominal (<i>volverse</i>)<br />VS(NP),VC(PPR,ACC,RPER,RNUM,RGEN),VC(JP,NP);<br /><br /><b>Y219</b><br />conjunction + IP (<i>cuando John fué al cine.</i>)<br />CP(IP);<br /><br /><b>Y253</b><br />Adjetivos cuyo complemento es introducido por "de"  (<i>libre, cansado</i>)<br />JC(PH([de]));<br /><br /><b>Y254</b><br />Adjetivos cuyo complemento es introducido por "en" (<i>interesado</i>)<br />JC(PH([en]));<br /><br /><b>Y255</b><br />Adjetivos cuyo complement es introducido por "a" (<i>similar</i>)<br />JC(PH([a]));<br /><br /></body>
